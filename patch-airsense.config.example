# Copy to patch-airsense.config to use these options.
# This .example file is not loaded automatically.
# Uncomment options to override built-in defaults; use y to enable, n to disable.
# AIR10_PATCH_ARGS and CLI options take precedence.

# Preset: its options come first; options below override them.
# --preset plus

# Patch selection: built-in defaults.
# --patch-extra-modes y
# --patch-unlock-uilimits y
# --patch-unlock-options y
# --patch-gui-config y
# --patch-ivaps-settings y
# --patch-asv-ps-range y
# --patch-adjustable-mcp n
# --patch-integrity-check y
# --patch-bypass-psuid y
# --patch-unlock-languages y
# --patch-defaults y
# --patch-fw-backlight y
# --patch-custom-palette y
# --patch-past-date y
# --patch-custom-settings y
# --patch-uart-stream-schema y
# --patch-edf-merge y
# --patch-fw-vidspoof y
# --patch-therapy-screen y
# --patch-motor-nagscreen y
# --patch-blx-dump y

# Optional payloads: built-in defaults shown below.
# Custom VAuto.
# --patch-fw-vauto-wrapper n

# Square Wave.
# --patch-fw-squarewave n

# ASV backup-rate runtime control.
# --patch-fw-asv-wrapper n

# Keep the screen awake for +Graph choices; requires --patch-therapy-screen.
# --patch-graph-keep-screen-on n

# Replacement ILI9325/ILI9328 LCD.
# --patch-fw-lcd n

# Humid Start: hold the heated tube back while the humidifier warms up; SX567 only.
# --patch-humid-start n

# Climate target relative humidity, percent.
# With custom settings, initializes Target RH (%) in Accessories (70-100, step 1).
# --patch-target-rh y
# --target-rh 85

# Configuration reference: docs/patch_options.md
# Feature reference: docs/guide/patching.md
