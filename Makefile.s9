S9_PATCH_ARGS ?=
S9_FIRMWARE ?= stm32-s9.bin
export S9_PATCH_ARGS
ifneq ($(origin PATCH_S9_LCD),undefined)
export PATCH_S9_LCD
endif

# S9 LCD patch - detect ILI9225 or retain the native display driver
#
# Build: make s9_lcd_driver
# Usage: PATCH_S9_LCD=1 ./patch-airsense-s9 stm32-s9.bin output.bin
#
# S9 is STM32F103 (Cortex-M3), different flags from S10 (Cortex-M4)
# One binary per CDX version (stub addresses differ)

S9_CFLAGS := -Os -mcpu=cortex-m3 -mthumb \
	-W -Wall -Wno-unused-variable \
	-nostdlib -nostdinc -ffreestanding

$(eval $(call compiler_config,s9,CC S9_CFLAGS))

S9_LCD_OFFSET := 0x080d8000
S9_VERSIONS := 1201 1203 1301

$(BUILD)/s9_lcd.o: $(SRC)/s9_lcd.c Makefile Makefile.s9 $(BUILD)/s9.flags | $(BUILD)
	$(CC) $(S9_CFLAGS) $(DEPFLAGS) -c -o $@ $<

$(BUILD)/s9_lcd_native.o: $(SRC)/s9_lcd_native.S Makefile Makefile.s9 $(BUILD)/s9.flags | $(BUILD)
	$(CC) $(S9_CFLAGS) $(DEPFLAGS) -c -o $@ $<

# Generate per-version stubs + link + objcopy rules
define S9_LCD_VERSION_template
$(BUILD)/s9_$(1)_stubs.o: $(SRC)/s9_$(1)_stubs.S Makefile Makefile.s9 $(BUILD)/s9.flags | $(BUILD)
	$$(CC) $$(S9_CFLAGS) $$(DEPFLAGS) -c -o $$@ $$<

$(BUILD)/s9_lcd_$(1).elf: $(BUILD)/s9_lcd.o $(BUILD)/s9_lcd_native.o $(BUILD)/s9_$(1)_stubs.o | $(BUILD)
	$$(LD) --nostdlib --no-dynamic-linker \
		--Ttext $$(S9_LCD_OFFSET) --entry s9_lcd_init --sort-section=name \
		-o $$@ $$^

$(BUILD)/s9_lcd_$(1).bin: $(BUILD)/s9_lcd_$(1).elf
	$$(OBJCOPY) -Obinary $$< $$@
endef

$(foreach v,$(S9_VERSIONS),$(eval $(call S9_LCD_VERSION_template,$(v))))

s9_lcd_driver: $(foreach v,$(S9_VERSIONS),$(BUILD)/s9_lcd_$(v).bin)
	@echo "S9 LCD patches built:"
	@$(foreach v,$(S9_VERSIONS),echo "  $(BUILD)/s9_lcd_$(v).bin";)

# Keep the previous build target as an alias.
s9_lcd_ili9225: s9_lcd_driver

.PHONY: s9 s9_lcd s9_lcd_driver s9_lcd_ili9225
s9: $(BUILD)/stm32-s9.bin

s9_lcd: $(BUILD)/stm32-s9-lcd.bin

S9_PATCH_SOURCES = Makefile.s9 patch-airsense-s9 python/patch-airsense-s9.py python/lib/s9_firmware.py python/lib/compiled_payload.py
S9_PAYLOADS = $(foreach v,$(S9_VERSIONS),$(BUILD)/s9_lcd_$(v).bin)

$(BUILD)/stm32-s9.bin: $(S9_PATCH_SOURCES) $(S9_PAYLOADS) | $(BUILD)
	$(announce_image)
	./patch-airsense-s9 '$(S9_FIRMWARE)' $@ $(PATCHER_OUTPUT_ARGS)

$(BUILD)/stm32-s9-lcd.bin: $(S9_PATCH_SOURCES) $(S9_PAYLOADS) | $(BUILD)
	$(announce_image)
	PATCH_S9_LCD=1 ./patch-airsense-s9 '$(S9_FIRMWARE)' $@ $(PATCHER_OUTPUT_ARGS)

$(foreach image,$(BUILD)/stm32-s9.bin $(BUILD)/stm32-s9-lcd.bin,$(eval $(call patch_config_rule,$(image),s9,$(S9_FIRMWARE))))
