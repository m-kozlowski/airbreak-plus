#!/bin/bash

set -euo pipefail


die() { echo >&2 "$*"; exit 1; }


IN=${1:-}
OUT=${2:-}

if [[ -z "$IN" || -z "$OUT" ]]; then
    die "Usage: $0 input.bin output.bin [Python patch options]"
fi

if [[ ! -r "$IN" ]]; then
    die "$IN: can not open input file"
fi

shift 2

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PYTHON=${PYTHON:-python3}
PATCHER="$SCRIPT_DIR/python/patch-airsense-s11.py"

if [[ ! -r "$PATCHER" ]]; then
    die "$PATCHER: can not open python patcher"
fi

# Comment/uncomment patch names here to choose what this compatibility wrapper applies.
# The Python patcher always refreshes FGBL/CONF/APPL CRCs after selected patches.
PATCHES=(
    patch-airbreak-info
    patch-fgbl-service
    patch-unlock-features
    patch-unlock-languages
    patch-defaults
    patch-rpc-json-profile-visibility
    patch-edf-superset
    patch-vid-spoof
    patch-motor-nagscreen
    patch-asv-ps-range
    patch-therapy-screen
    patch-header-clock
    patch-asv-backup-rate
    patch-custom-settings
    patch-rpc-permissions
    patch-timezone-write
)

# METHOD:VCID:BOOL and DATAITEM:RPC|RPW:BOOL rules applied by patch-rpc-permissions.
# Known method sets:
#   docs/as11/rpc_protocol.md#method-sets
# Known VCIDs and their transport roles:
#   docs/as11/rpc_protocol.md#rpc-permission-selectors
# DataItem RPC/RPW flags:
#   docs/as11/conf_block_format.md#flags-field
RPC_PERMISSIONS=(
    SetDateTime:0x0396:1
    ApplyUpgrade:0x0396:1
    WUP:RPC:1
    WUP:RPW:1

    # GetLedStatus:0x0396:1
    # SetNextPowerUpDateTime:0x0396:1
    # ResetDevice:0x0396:1
    # StoreSecurityData:0x0396:1
    # VerifySecurityData:0x0396:1
    # ClearAutoConnectList:0x0396:1

    # uncomment the following to block OTA over cellular network
    # InitiateUpgrade:0x0780:0
    # InitiateUpgrade:0x0788:0
    # UpgradeDataBlock:0x0780:0
    # UpgradeDataBlock:0x0788:0
    # CheckUpgradeFile:0x0780:0
    # CheckUpgradeFile:0x0788:0
    # ApplyUpgrade:0x0780:0
    # ApplyUpgrade:0x0788:0
    # ApplyAuthenticatedUpgrade:0x0780:0
    # ApplyAuthenticatedUpgrade:0x0788:0
)

args=( "--all-patches" "n" )
for patch in "${PATCHES[@]}"; do
    args+=( "--$patch" "Y" )
done

for permission in "${RPC_PERMISSIONS[@]}"; do
    args+=( "--rpc-permission" "$permission" )
done

exec "$PYTHON" "$PATCHER" "$IN" "$OUT" PATCH --overwrite \
    "${args[@]}" "$@"
