#!/bin/bash

set -euo pipefail


die() { echo >&2 "$*"; exit 1; }


IN=${1:-}
OUT=${2:-}

if [[ -z "$IN" || -z "$OUT" ]]; then
    die "Usage: $0 input.bin output.bin [Python patch options]"
fi

if [[ ! -r "$IN" ]]; then
    die "$IN: can not open input file"
fi

shift 2

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PYTHON=${PYTHON:-python3}
PATCHER="$SCRIPT_DIR/python/patch-airsense.py"

if [[ ! -r "$PATCHER" ]]; then
    die "$PATCHER: can not open Python patcher"
fi


# Compatibility mapping for the build profiles historically exposed by this
# script. Python owns patch defaults, ordering, dependencies, and implementation.
common_code=0
graph=0
squarewave=0
asv_wrapper=0
vauto_wrapper=0
lcd=0
force_deprecated=0

if [[ ${PATCH_CODE:-0} == 1 ]]; then
    common_code=1
    graph=1
fi

if [[ ${PATCH_VAUTO_WRAPPER:-0} == 1 ]]; then
    common_code=1
    vauto_wrapper=1
fi

if [[ ${PATCH_S:-0} == 1 ]]; then
    [[ $vauto_wrapper == 1 ]] || \
        die "PATCH_S=1 requires PATCH_VAUTO_WRAPPER=1"
    squarewave=1
fi

if [[ ${PATCH_ASV_TASK_WRAPPER:-0} == 1 ]]; then
    asv_wrapper=1
fi

if [[ ${PATCH_S10_LCD:-0} == 1 ]]; then
    lcd=1
fi

if [[ ${FORCE_DEPRECATED:-0} == 1 ]]; then
    force_deprecated=1
fi


args=()

if (( common_code )); then
    args+=(--patch-fw-common-code Y)
fi
if (( graph )); then
    args+=(--patch-fw-graph Y)
fi
if (( squarewave )); then
    args+=(--patch-fw-squarewave Y)
fi
if (( asv_wrapper )); then
    args+=(--patch-fw-asv-wrapper Y)
fi
if (( vauto_wrapper )); then
    args+=(--patch-fw-vauto-wrapper Y)
fi
if (( lcd )); then
    args+=(--patch-fw-lcd Y)
fi
if (( force_deprecated )); then
    args+=(--force-deprecated)
fi

# Bash 3.2 treats an empty array as unset when nounset is enabled.
exec "$PYTHON" "$PATCHER" "$IN" "$OUT" PATCH --overwrite "${args[@]+"${args[@]}"}" "$@"
