custom_patch_settings_reclaim_reminders() {
    local reminders_tick reminder_menu_item reminder_menu_item_end reminder_menu reminder_menu_end
    case "$CDX_VER" in
        SX567-0401)
            reminders_tick=0xec446
            reminder_menu_item=0x62754
            reminder_menu_item_end=0x62790
            reminder_menu=0x63778
            reminder_menu_end=0x639d4
            ;;
        SX567-0402)
            reminders_tick=0xec6be
            reminder_menu_item=0x62754
            reminder_menu_item_end=0x62790
            reminder_menu=0x63778
            reminder_menu_end=0x639d4
            ;;
        *)
            echo "  custom_patch_settings: skipped (unsupported CDX version $CDX_VER)"
            return 1
            ;;
    esac

    # bx lr ; disable reminder periodic processing.
    if printf '\x38\xb5\x04\x46' | check_patch "$reminders_tick"; then
        printf '\x70\x47' | patch "$reminders_tick" || die failed
    elif ! printf '\x70\x47' | check_patch "$reminders_tick"; then
        die "custom_patch_settings: unexpected reminder tick bytes"
    fi

    local item_reclaim=$(( reminder_menu_item + 2 ))
    local item_reclaim_size=$(( reminder_menu_item_end - item_reclaim ))

    # b after scrollbar_add_item ; skip visible Reminders row between SmartStart and Configuration.
    if printf '\x08\x20\x01\xf0' | check_patch "$reminder_menu_item"; then
        printf '\x1c\xe0' | patch "$reminder_menu_item" || die failed
        fill_ff "$item_reclaim" "$item_reclaim_size" || die failed
    elif ! printf '\x1c\xe0' | check_patch "$reminder_menu_item"; then
        die "custom_patch_settings: unexpected reminder menu item bytes"
    fi

    local reclaim=$(( reminder_menu + 6 ))
    local reclaim_size=$(( reminder_menu_end - reclaim ))

    # movs r4,#0; str r4,[r5,#0x74]; b end ; clear Reminders page slot, then skip children.
    if printf '\x2c\x20\x00\xf0' | check_patch "$reminder_menu"; then
        printf '\x00\x24\x6c\x67\x2a\xe1' | patch "$reminder_menu" || die failed
        fill_ff "$reclaim" "$reclaim_size" || die failed
    elif ! printf '\x00\x24\x6c\x67\x2a\xe1' | check_patch "$reminder_menu"; then
        die "custom_patch_settings: unexpected reminder menu bytes"
    fi

    CUSTOM_SETTINGS_REGISTRY_ADDR=$reclaim
    CUSTOM_SETTINGS_REGISTRY_SIZE=$reclaim_size

    printf "  disabled stock Reminders menu item at 0x%08X\n" \
        $(( FLASH_BASE + reminder_menu_item ))
    printf "  reclaimed 0x%08X..0x%08X (%d bytes) padded with FF\n" \
        $(( FLASH_BASE + item_reclaim )) $(( FLASH_BASE + reminder_menu_item_end - 1 )) "$item_reclaim_size"
    printf "  disabled stock Reminders page slot at 0x%08X\n" \
        $(( FLASH_BASE + reminder_menu ))
    printf "  reclaimed 0x%08X..0x%08X (%d bytes) padded with FF\n" \
        $(( FLASH_BASE + reclaim )) $(( FLASH_BASE + reminder_menu_end - 1 )) "$reclaim_size"
}

custom_patch_settings_myasv() {
    # RPO = recurrence enable: Mask
    local RPO
    RPO=$(find_var RPO) || die failed

    # Rewrite RPO into the custom ASV enable switch.
    printf '\x07\x00' | patch $(( RPO + 0x00 )) || die failed # flags: ACT|VIS|EDT
    printf '\x00'     | patch $(( RPO + 0x02 )) || die failed # no callback
    printf '\xff\x7f' | patch $(( RPO + 0x04 )) || die failed # no dependent numeric settings
    printf '\xf8\x00' | patch $(( RPO + 0x06 )) || die failed # name string: ASV
    printf '\x00\x02' | patch $(( RPO + 0x08 )) || die failed # default=Off, options=2
    printf '\x00\x00' | patch $(( RPO + 0x0A )) || die failed
    printf '\x03\x00\x00\x00' | patch $(( RPO + 0x0C )) || die failed # allowed option bits: Off, On
    printf '\x3e\x01' | patch $(( RPO + 0x10 )) || die failed         # option strings: Off, On
    printf '\x00\x00' | patch $(( RPO + 0x12 )) || die failed
}

custom_patch_settings() {
    echo "Preparing custom patch settings"
    custom_patch_settings_reclaim_reminders || return
    custom_patch_settings_myasv
}

unlock_languages() {
    echo "Unlocking all languages..."
    local addr=$(find_var LNC)
    # make variable read only to prevent overwriting with eeprom data
    printf '\x06' | patch $addr
    # 0x007fffff, except font-reserved bits jp (13,19) and cn (16,17).
    printf '\xff\xdf\x74\x00' | patch $(( addr + 0x08 ))
}



custom_palette() {
    echo "Patching custom color palette"
    # Find palette base by signature - tested on 0401 and 0402
    local base
    base=$(find_bytes "286031BD61020000FFFFFF0096969600") || {
        echo "  custom_palette: palette signature not found"; return 1
    }
    base=$(( base + 8 ))  # first color entry

    # Selected item color
    printf '\xCC\x33\x00\x00' | patch $(( base + 0x24 ))

    # Whites
    for off in 0x00 0x1C 0x28 0x40 0x44 0x48 0x54 0x70 0x7C 0x94 0x98 0x9C ; do
        printf '\xFF\xBB\x44\x00' | patch $(( base + off ))
    done

    # Bright grays (highlights mostly)
    for off in 0x04 0x0C 0x58 0x60 0x74 ; do
        printf '\x96\x48\x48\x00' | patch $(( base + off ))
    done

    # Mid grays (buttons)
    for off in 0x08 0x5C ; do
        printf '\x64\x32\x32\x00' | patch $(( base + off ))
    done

    # Low grays (disabled, backgrounds)
    for off in 0x10 0x14 0x30 0x4C 0x64 0x68 0x84 0xA0 ; do
        printf '\x40\x20\x20\x00' | patch $(( base + off ))
    done

    # Blacks
    for off in 0x18 0x34 0x50 0x6C 0x88 0xA4 ; do
        printf '\x08\x00\x08\x00' | patch $(( base + off ))
    done
}

