# Rewrite a g[8] descriptor with caller-provided raw descriptor fields.
# args: var flags callback dep_head name_str default num_options param_0a perm_mask base_str param_12
redefine_g8_var() {
    local var=$1 flags=$2 callback=$3 dep=$4 name_str=$5 default=$6 num_options=$7 param_0a=$8 perm_mask=$9
    local base_str=${10} param_12=${11}
    local rec
    rec=$(find_var "$var") || die failed
    write_u16 $(( rec + G8_FLAGS )) "$flags" || die failed
    write_u8  $(( rec + G8_CALLBACK )) "$callback" || die failed
    write_u16 $(( rec + G8_DEP_HEAD )) "$dep" || die failed
    write_u16 $(( rec + G8_NAME_STR )) "$name_str" || die failed
    write_u8  $(( rec + G8_DEFAULT )) "$default" || die failed
    write_u8  $(( rec + G8_NUM_OPTIONS )) "$num_options" || die failed
    write_u16 $(( rec + G8_PARAM_0A )) "$param_0a" || die failed
    write_u32 $(( rec + G8_BITMASK )) "$perm_mask" || die failed
    write_u16 $(( rec + G8_BASE_STR )) "$base_str" || die failed
    write_u16 $(( rec + G8_PARAM_12 )) "$param_12" || die failed
}


# Rewrite a g[4] numeric descriptor with caller-provided raw descriptor fields.
# args: var flags callback next_chain name_str default max min decimals scale step units_str
redefine_g4_var() {
    local var=$1 flags=$2 callback=$3 next_chain=$4 name_str=$5 default=$6 max=$7 min=$8
    local decimals=$9 scale=${10} step=${11} units_str=${12}
    local rec
    rec=$(find_var "$var") || die failed
    write_u16 $(( rec + G4_FLAGS )) "$flags" || die failed
    write_u8  $(( rec + G4_CALLBACK )) "$callback" || die failed
    write_u16 $(( rec + G4_NEXT_DEP )) "$next_chain" || die failed
    write_u16 $(( rec + G4_NAME_STR )) "$name_str" || die failed
    write_u32 $(( rec + G4_DEFAULT )) "$default" || die failed
    write_u32 $(( rec + G4_MAX )) "$max" || die failed
    write_u32 $(( rec + G4_MIN )) "$min" || die failed
    write_u8  $(( rec + G4_DECIMALS )) "$decimals" || die failed
    write_u16 $(( rec + G4_SCALE )) "$scale" || die failed
    write_u16 $(( rec + G4_STEP )) "$step" || die failed
    write_u16 $(( rec + G4_UNITS_STR )) "$units_str" || die failed
}


MOP_IDX_CPAP=0
MOP_IDX_AUTOSET=1
MOP_IDX_APAP=2
MOP_IDX_S=3
MOP_IDX_ST=4
MOP_IDX_T=5
MOP_IDX_VAUTO=6
MOP_IDX_ASV=7
MOP_IDX_ASVAUTO=8
MOP_IDX_IVAPS=9
MOP_IDX_PAC=10
MOP_IDX_AFH=11


# Build a g[24]/MOP visibility mask from MOP names or numeric indexes.
MOP_BITMASK() {
    local mask=0 arg idx
    for arg in "$@"; do
        case "${arg^^}" in
            CPAP) idx=$MOP_IDX_CPAP ;;
            AUTOSET) idx=$MOP_IDX_AUTOSET ;;
            APAP) idx=$MOP_IDX_APAP ;;
            S) idx=$MOP_IDX_S ;;
            ST) idx=$MOP_IDX_ST ;;
            T) idx=$MOP_IDX_T ;;
            VAUTO) idx=$MOP_IDX_VAUTO ;;
            ASV) idx=$MOP_IDX_ASV ;;
            ASVAUTO) idx=$MOP_IDX_ASVAUTO ;;
            IVAPS) idx=$MOP_IDX_IVAPS ;;
            PAC) idx=$MOP_IDX_PAC ;;
            AFH) idx=$MOP_IDX_AFH ;;
            *)
                [[ "$arg" =~ ^(0[xX][0-9a-fA-F]+|[0-9]+)$ ]] || die "MOP_BITMASK: unknown MOP '$arg'"
                idx=$(( arg ))
                ;;
        esac
        mask=$(( mask | (1 << idx) ))
    done
    printf "%d\n" "$mask"
}


# Register one variable to be appended to a clinical menu section.
# args: section name, variable name/id, mode visibility mask
custom_menu_add() {
    local section_name=${1,,} var=$2 mode_mask=${3:-0xffffffff}
    local section=${CUSTOM_MENU_SECTIONS[$section_name]}
    [[ -n "$section" ]] || die "custom_menu_add: unknown section $1"

    local vid table flags=0
    vid=$(( $(resolve_var_id "$var") ))
    table=$(find_var_table_number "$var")
    case "$table" in
        4) flags=$CUSTOM_MENU_FLAG_G4_NUMERIC ;;
        8) flags=0 ;;
        *) die "custom_menu_add: $var is globals[$table], only g[4]/g[8] menu settings are supported" ;;
    esac
    mode_mask=$(( mode_mask ))
    if [[ -n "${CUSTOM_MENU_REGISTERED[$vid]+x}" ]]; then
        die "custom_menu_add: duplicate variable $var (var_id 0x$(printf "%04X" "$vid"))"
    fi
    CUSTOM_MENU_REGISTERED[$vid]=1
    CUSTOM_MENU_ENTRIES+=("$section $flags $vid $mode_mask")
}


# Serialize the generated registry into the reclaimed Reminders page space.
custom_emit_registry() {
    local need=$(( (${#CUSTOM_MENU_ENTRIES[@]} + 1) * 8 ))
    (( need <= CUSTOM_SETTINGS_REGISTRY_SIZE )) || \
        die "custom_patch_settings: registry ${need}B exceeds reclaimed ${CUSTOM_SETTINGS_REGISTRY_SIZE}B"

    local off=$CUSTOM_SETTINGS_REGISTRY_ADDR entry section flags vid mode_mask
    for entry in "${CUSTOM_MENU_ENTRIES[@]}"; do
        read -r section flags vid mode_mask <<< "$entry"
        write_u8  "$off" "$section" || die failed
        write_u8  $(( off + 1 )) "$flags" || die failed
        write_u16 $(( off + 2 )) "$vid" || die failed
        write_u32 $(( off + 4 )) "$mode_mask" || die failed
        off=$(( off + 8 ))
    done
    fill_ff "$off" 8 || die failed
}


# Replace one stock section-tail append call with a hook call.
# args: patch site offset, expected bytes, hook target flash address, site label
custom_patch_menu_hook_site() {
    local site=$1 expected=$2 target=$3 name=$4
    if ! printf '%b' "$expected" | check_patch "$site"; then
        die "custom_patch_settings: unexpected $name hook bytes at 0x$(printf "%X" "$site")"
    fi
    encode_thumb_bl "$site" "$target" | patch "$site" || die failed
}


# The clinical settings page uses one pre-sized scrollbar for all sections.
# Grow its item-pointer array before section hooks append generated entries.
# args: movs-r2-immediate offset, stock capacity
custom_patch_clinical_menu_capacity() {
    local imm_off=$1 stock_capacity=$2
    local custom_count=${#CUSTOM_MENU_ENTRIES[@]}
    local new_capacity=$(( stock_capacity + custom_count ))

    if (( $(read_u8 "$imm_off") != stock_capacity || $(read_u8 $(( imm_off + 1 ))) != 0x22 )); then
        die "custom_patch_settings: unexpected clinical menu capacity bytes at 0x$(printf "%X" "$imm_off")"
    fi
    (( new_capacity <= 0xff )) || die "custom_patch_settings: clinical menu capacity exceeds Thumb imm8"
    write_u8 "$imm_off" "$new_capacity" || die failed
    printf "  clinical menu capacity: %d -> %d\n" "$stock_capacity" "$new_capacity"
}


# Inject the generic clinical-menu hook payload and patch its ABI slots.
custom_patch_menu_hooks() {
    local ver bin elf size registry_flash
    local therapy_site comfort_site accessories_site options_site configuration_site
    local callback_table clinical_capacity_site clinical_capacity
    local hook_therapy hook_comfort hook_accessories hook_options hook_configuration
    local hook_mop_callback registry_addr original_cb_addr
    local mop_rec mop_callback_id mop_callback_slot original_mop_callback hook_mop_callback_thumb
    ver="${CDX_VER#SX567-}"

    case "$CDX_VER" in
        SX567-0401|SX567-0402)
            therapy_site=0x62414
            comfort_site=0x62672
            accessories_site=0x626fe
            options_site=0x62750
            configuration_site=0x628d2
            callback_table=0x75f48
            clinical_capacity_site=0x61fba
            clinical_capacity=70
            ;;
        *)
            echo "  ${FUNCNAME[0]}: skipped (unsupported CDX version $CDX_VER)"
            return
            ;;
    esac

    bin="build/custom_menu_hooks_${ver}.bin"
    elf="build/custom_menu_hooks_${ver}.elf"
    if [[ ! -r "$bin" ]]; then
        die "custom_patch_settings: $bin not found; run make custom_menu_hooks_${ver}.bin"
    fi
    [[ -r "$elf" ]] || die "custom_patch_settings: $elf not found"

    size=$(stat -c %s "$bin")
    if (( size > CUSTOM_MENU_HOOKS_BUDGET )); then
        die "custom_patch_settings: $bin is ${size}B, exceeds ${CUSTOM_MENU_HOOKS_BUDGET}B budget"
    fi
    if ! check_ff "$CUSTOM_MENU_HOOKS_OFF" "$CUSTOM_MENU_HOOKS_BUDGET"; then
        local payload_hex
        payload_hex=$(printf "%X" "$CUSTOM_MENU_HOOKS_OFF")
        die "custom_patch_settings: payload area 0x$payload_hex is not empty"
    fi

    patch_direct "$bin" "$CUSTOM_MENU_HOOKS_OFF"
    registry_flash=$(( FLASH_BASE + CUSTOM_SETTINGS_REGISTRY_ADDR ))

    hook_therapy=$(elf_symbol_addr "$elf" custom_menu_hook_therapy)
    hook_comfort=$(elf_symbol_addr "$elf" custom_menu_hook_comfort)
    hook_accessories=$(elf_symbol_addr "$elf" custom_menu_hook_accessories)
    hook_options=$(elf_symbol_addr "$elf" custom_menu_hook_options)
    hook_configuration=$(elf_symbol_addr "$elf" custom_menu_hook_configuration)
    hook_mop_callback=$(elf_symbol_addr "$elf" custom_menu_mop_callback_hook)
    registry_addr=$(elf_symbol_addr "$elf" custom_menu_registry_addr)
    original_cb_addr=$(elf_symbol_addr "$elf" custom_menu_original_mop_callback)
    mop_rec=$(find_var MOP)
    mop_callback_id=$(read_u8 $(( mop_rec + G8_CALLBACK )))
    mop_callback_slot=$(( callback_table + mop_callback_id * 4 ))
    original_mop_callback=$(read_u32 "$mop_callback_slot")
    hook_mop_callback_thumb=$(( hook_mop_callback | 1 ))

    write_u32 $(( registry_addr - FLASH_BASE )) "$registry_flash" || die failed
    write_u32 $(( original_cb_addr - FLASH_BASE )) "$original_mop_callback" || die failed

    custom_patch_clinical_menu_capacity "$clinical_capacity_site" "$clinical_capacity"
    custom_patch_menu_hook_site "$therapy_site" "\\x02\\xf0\\x3a\\xfd" "$hook_therapy" therapy
    custom_patch_menu_hook_site "$comfort_site" "\\x02\\xf0\\x0b\\xfc" "$hook_comfort" comfort
    custom_patch_menu_hook_site "$accessories_site" "\\x02\\xf0\\xc5\\xfb" "$hook_accessories" accessories
    custom_patch_menu_hook_site "$options_site" "\\x02\\xf0\\x9c\\xfb" "$hook_options" options
    custom_patch_menu_hook_site "$configuration_site" "\\x02\\xf0\\xdb\\xfa" "$hook_configuration" configuration
    write_u32 "$mop_callback_slot" "$hook_mop_callback_thumb" || die failed

    printf "  custom menu hooks: %s (%dB) at 0x%08X\n" "$bin" "$size" "$CUSTOM_MENU_HOOKS_FLASH"
    printf "  MOP callback[%d]: 0x%08X -> 0x%08X\n" \
        "$mop_callback_id" "$original_mop_callback" "$hook_mop_callback_thumb"
}



