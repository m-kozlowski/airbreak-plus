# Disable stock Reminder behavior and add its storage-backed variables to pools.
# Reclaimed Reminder vars:
#   g[8] RPF/RPO/RPH/RPW: recurrence enable for Filter/Mask/Tube/Water Tub
#   g[8] RXF/RXM/RXH/RXW: reminder-date enable for Filter/Mask/Tube/Water Tub
#   g[4] RCF/RCM/RCH/RCW: recurrence period value in months
#   g[4] RDF/RDM/RDH/RDW: reminder due-date value
custom_patch_settings_reclaim_reminders() {
    local reminders_tick reminder_menu_item reminder_menu_item_end reminder_menu reminder_menu_end
    local reclaimed_string_ids
    case "$CDX_VER" in
        SX567-0401)
            reminders_tick=0xec446
            reminder_menu_item=0x62754
            reminder_menu_item_end=0x62790
            reminder_menu=0x63778
            reminder_menu_end=0x639d4
            reclaimed_string_ids="0x0048 0x00B7 0x00B8 0x00B9 0x00BA" # Reminders + four reminder message bodies
            ;;
        SX567-0402)
            reminders_tick=0xec6be
            reminder_menu_item=0x62754
            reminder_menu_item_end=0x62790
            reminder_menu=0x63778
            reminder_menu_end=0x639d4
            reclaimed_string_ids="0x0048 0x00B7 0x00B8 0x00B9 0x00BA" # Reminders + four reminder message bodies
            ;;
        *)
            echo "  custom_patch_settings: skipped (unsupported CDX version $CDX_VER)"
            return 1
            ;;
    esac

    # disable reminder periodic processing.
    # bx lr ;
    if printf '\x38\xb5\x04\x46' | check_patch "$reminders_tick"; then
        printf '\x70\x47' | patch "$reminders_tick" || die failed
    elif ! printf '\x70\x47' | check_patch "$reminders_tick"; then
        die "custom_patch_settings: unexpected reminder tick bytes"
    fi

    local item_reclaim=$(( reminder_menu_item + 2 ))
    local item_reclaim_size=$(( reminder_menu_item_end - item_reclaim ))

    # skip visible Reminders menu item between SmartStart and Configuration.
    # b after scrollbar_add_item ;
    if printf '\x08\x20\x01\xf0' | check_patch "$reminder_menu_item"; then
        printf '\x1c\xe0' | patch "$reminder_menu_item" || die failed
        fill_ff "$item_reclaim" "$item_reclaim_size" || die failed
    elif ! printf '\x1c\xe0' | check_patch "$reminder_menu_item"; then
        die "custom_patch_settings: unexpected reminder menu item bytes"
    fi
    local str_id
    for str_id in $reclaimed_string_ids; do
        custom_note_reclaimed_string_id "$str_id"
    done

    local reclaim=$(( reminder_menu + 6 ))
    local reclaim_size=$(( reminder_menu_end - reclaim ))

    # clear Reminders page slot, then skip children.
    # movs r4,#0; str r4,[r5,#0x74]; b end ;
    if printf '\x2c\x20\x00\xf0' | check_patch "$reminder_menu"; then
        printf '\x00\x24\x6c\x67\x2a\xe1' | patch "$reminder_menu" || die failed
        fill_ff "$reclaim" "$reclaim_size" || die failed
    elif ! printf '\x00\x24\x6c\x67\x2a\xe1' | check_patch "$reminder_menu"; then
        die "custom_patch_settings: unexpected reminder menu bytes"
    fi

    CUSTOM_SETTINGS_REGISTRY_ADDR=$reclaim
    CUSTOM_SETTINGS_REGISTRY_SIZE=$reclaim_size

    local var
    for var in RPO RPH RPF RPW RXM RXH RXF RXW; do
        custom_reclaim_g8_var "$var"
    done
    for var in RDF RDM RDH RDW RCF RCM RCH RCW; do
        custom_reclaim_g4_var "$var"
    done

    printf "  disabled stock Reminders menu item at 0x%08X\n" \
        $(( FLASH_BASE + reminder_menu_item ))
    printf "  reclaimed 0x%08X..0x%08X (%d bytes) padded with FF\n" \
        $(( FLASH_BASE + item_reclaim )) $(( FLASH_BASE + reminder_menu_item_end - 1 )) "$item_reclaim_size"
    printf "  disabled stock Reminders page slot at 0x%08X\n" \
        $(( FLASH_BASE + reminder_menu ))
    printf "  reclaimed 0x%08X..0x%08X (%d bytes) padded with FF\n" \
        $(( FLASH_BASE + reclaim )) $(( FLASH_BASE + reminder_menu_end - 1 )) "$reclaim_size"
}


# Reuse reclaimed Reminder vars as custom ASV runtime settings, expose them in
# the clinical Therapy menu, and pass their var_ids to the VAuto wrapper.
custom_patch_settings_myasv() {
    declare -A MYASV_LABEL=([0]="Custom ASV")
    declare -A MYASV_TC_LABEL=([0]="Custom T/C")
    declare -A MYASV_MAX_LABEL=([0]="ASV Max")
    declare -A MYASV_SENS_LABEL=([0]="ASV Sens")
    local myasv_var myasv_label myasv_vid myasv_dep
    local tc_var tc_label tc_vid
    local max_var max_label max_vid cmh2o_units
    local sens_var sens_label sens_vid sens_base
    local ver elf addr tc_addr max_addr sens_addr

    # Claim stable storage-backed variables for this feature and allocate
    # reclaimed localized string IDs for their menu labels.
    custom_claim_g8_var myasv_var RPO my_asv_enable
    custom_claim_g8_var tc_var    RPH my_asv_triggercycle
    custom_claim_g4_var max_var   RCM my_asv_max
    custom_claim_g8_var sens_var  RXM my_asv_sens
    redefine_fw_string myasv_label -1 MYASV_LABEL
    redefine_fw_string tc_label    -1 MYASV_TC_LABEL
    redefine_fw_string max_label   -1 MYASV_MAX_LABEL
    redefine_fw_string sens_label  -1 MYASV_SENS_LABEL

    # Rewrite claimed descriptors for their new meanings. Keep the original
    # Reminder update chain root (RGT), because these variables still live in the
    # same persisted Reminder group and should dirty/save that group normally.
    myasv_dep=$(find_var_table_index 4 RGT)
    cmh2o_units=$(read_u16 $(( $(find_var IPC) + G4_UNITS_STR ))) # IPC = cpap pressure
    sens_base=$(read_u16 $(( $(find_var VCS) + G8_BASE_STR )))
    #                            #flags  #callback #dep_chain   #name_str_id   #default #opt_count #param_0a #opt_mask  #options_str_base     #param_12
    redefine_g8_var "$myasv_var" 0x0007  0         "$myasv_dep" "$myasv_label" 0        2          0         0x00000003 "$STR_ID_OFF_ON_BASE" 0
    redefine_g8_var "$tc_var"    0x0007  0         "$myasv_dep" "$tc_label"    0        2          0         0x00000003 "$STR_ID_OFF_ON_BASE" 0
    redefine_g8_var "$sens_var"  0x0007  0         "$myasv_dep" "$sens_label"  2        5          0         0x0000001F "$sens_base"          0
    #                            #flags  #callback #dep_chain   #name_str_id   #default #max       #min  #decimals  #scale   #step #units
    redefine_g4_var "$max_var"   0x0007  0         "$myasv_dep" "$max_label"   150      500        0     1          50       10    "$cmh2o_units"

    # The menu/descriptor side can use the UART name, but injected runtime code
    # only gets a compact numeric var_id through its ABI slot.
    myasv_vid=$(resolve_var_id "$myasv_var")
    tc_vid=$(resolve_var_id "$tc_var")
    max_vid=$(resolve_var_id "$max_var")
    sens_vid=$(resolve_var_id "$sens_var")

    # Register the variable for the generic menu hook; registry emission and hook
    # injection are handled later by custom_patch_settings().
    custom_menu_add therapy "$myasv_var" "$(MOP_BITMASK VAuto)"
    custom_menu_add therapy "$max_var"   "$(MOP_BITMASK VAuto)"
    custom_menu_add therapy "$sens_var"  "$(MOP_BITMASK VAuto)"
    custom_menu_add therapy "$tc_var"    "$(MOP_BITMASK S ST T VAuto PAC)"

    # The wrapper binary is built before patching and exposes writable ABI slots.
    # Patch those slots with claimed var_ids so wrapper code stays independent
    # from the custom menu framework and from firmware-specific numeric IDs.
    ver=${CDX_VER#SX567-}
    elf=build/wrapper_limit_max_pdiff_${ver}.elf
    [[ -r "$elf" ]] || die "custom_patch_settings_myasv: $elf not found"
    addr=$(elf_symbol_addr "$elf" wrapper_limit_max_pdiff_toggle_var_id)
    write_u16 $(( addr - FLASH_BASE )) "$(( myasv_vid ))" || die failed
    tc_addr=$(elf_symbol_addr "$elf" wrapper_limit_max_pdiff_triggercycle_var_id)
    write_u16 $(( tc_addr - FLASH_BASE )) "$(( tc_vid ))" || die failed
    max_addr=$(elf_symbol_addr "$elf" wrapper_limit_max_pdiff_asv_max_var_id)
    write_u16 $(( max_addr - FLASH_BASE )) "$(( max_vid ))" || die failed
    sens_addr=$(elf_symbol_addr "$elf" wrapper_limit_max_pdiff_asv_sens_var_id)
    write_u16 $(( sens_addr - FLASH_BASE )) "$(( sens_vid ))" || die failed

    printf "  my_asv enable: %s var_id=0x%04X label_str=0x%04X\n" \
        "$myasv_var" "$(( myasv_vid ))" "$myasv_label"
    printf "  my_asv max: %s var_id=0x%04X label_str=0x%04X\n" \
        "$max_var" "$(( max_vid ))" "$max_label"
    printf "  my_asv sens: %s var_id=0x%04X label_str=0x%04X\n" \
        "$sens_var" "$(( sens_vid ))" "$sens_label"
    printf "  my_asv trigger/cycle: %s var_id=0x%04X label_str=0x%04X\n" \
        "$tc_var" "$(( tc_vid ))" "$tc_label"
    printf "  VAuto wrapper toggle var_id=0x%04X at 0x%08X\n" "$(( myasv_vid ))" "$addr"
    printf "  VAuto wrapper ASV max var_id=0x%04X at 0x%08X\n" "$(( max_vid ))" "$max_addr"
    printf "  VAuto wrapper ASV sens var_id=0x%04X at 0x%08X\n" "$(( sens_vid ))" "$sens_addr"
    printf "  trigger/cycle toggle var_id=0x%04X at 0x%08X\n" "$(( tc_vid ))" "$tc_addr"
}


# Reuse a reclaimed Reminder switch to enable/disable the injected squarewave
# pressure waveform while preserving the stock handler for the Off path.
custom_patch_settings_squarewave() {
    declare -A SQUAREWAVE_LABEL=([0]="Square Wave")
    local square_var square_label square_vid square_dep
    local ver elf enable_addr

    custom_claim_g8_var square_var RPF squarewave_enable
    redefine_fw_string square_label -1 SQUAREWAVE_LABEL

    square_dep=$(find_var_table_index 4 RGT)
    #                             #flags #callback #dep_chain    #name_str_id    #default #opt_count #param_0a #opt_mask  #options_str_base     #param_12
    redefine_g8_var "$square_var" 0x0007 0         "$square_dep" "$square_label" 1        2          0         0x00000003 "$STR_ID_OFF_ON_BASE" 0

    square_vid=$(resolve_var_id "$square_var")
    custom_menu_add therapy "$square_var" "$(MOP_BITMASK S ST T PAC)"

    ver=${CDX_VER#SX567-}
    elf=build/squarewave_${ver}.elf
    [[ -r "$elf" ]] || die "custom_patch_settings_squarewave: $elf not found"
    enable_addr=$(elf_symbol_addr "$elf" squarewave_enable_var_id)
    write_u16 $(( enable_addr - FLASH_BASE )) "$(( square_vid ))" || die failed

    printf "  squarewave enable: %s var_id=0x%04X label_str=0x%04X\n" \
        "$square_var" "$(( square_vid ))" "$square_label"
    printf "  squarewave toggle var_id=0x%04X at 0x%08X\n" \
        "$(( square_vid ))" "$enable_addr"
}


# Select active custom-settings feature functions. The framework itself should
# run only when at least one feature needs reclaimed variables/menu hooks.
custom_patch_settings_collect_features() {
    CUSTOM_SETTINGS_FEATURES=()

    if [[ $PATCH_CODE == 1 && $PATCH_VAUTO_WRAPPER == 1 ]]; then
        CUSTOM_SETTINGS_FEATURES+=(custom_patch_settings_myasv)
    fi
    if [[ $PATCH_CODE == 1 && $PATCH_S == 1 ]]; then
        CUSTOM_SETTINGS_FEATURES+=(custom_patch_settings_squarewave)
    fi
}


# Orchestrate reclaim, feature registration, registry emit, and hook injection.
custom_patch_settings() {
    custom_patch_settings_collect_features
    if (( ${#CUSTOM_SETTINGS_FEATURES[@]} == 0 )); then
        echo "Skipping custom patch settings (no active features)"
        return
    fi

    echo "Preparing custom patch settings"
    custom_patch_settings_init
    custom_patch_settings_reclaim_reminders || return
    custom_build_string_pool

    local feature
    for feature in "${CUSTOM_SETTINGS_FEATURES[@]}"; do
        "$feature"
    done

    custom_emit_registry
    custom_patch_menu_hooks
}


# Print reclaimed-resource state after all patch passes had a chance to consume it.
# args: label count [items...]
print_custom_resource_summary_line() {
    local label=$1 count=$2
    shift 2
    printf "  %s: %d" "$label" "$count"
    if (( count > 0 )); then
        printf " (%s" "$1"
        shift
        local item
        for item in "$@"; do
            printf ", %s" "$item"
        done
        printf ")"
    fi
    printf "\n"
}


print_custom_resource_summary() {
    local touched=$(( ${#CUSTOM_G8_RECLAIMED[@]} + ${#CUSTOM_G4_RECLAIMED[@]} + ${#CUSTOM_RECLAIMED_STRING_CANDIDATES[@]} ))
    (( touched > 0 )) || return

    local unused_g8=() unused_g4=() free_str_ids=()
    local var vid str_id
    for var in "${CUSTOM_G8_POOL[@]}"; do
        vid=$(( $(resolve_var_id "$var") ))
        [[ -z "${CUSTOM_G8_CLAIMS[$vid]+x}" ]] && unused_g8+=("$var")
    done
    for var in "${CUSTOM_G4_POOL[@]}"; do
        vid=$(( $(resolve_var_id "$var") ))
        [[ -z "${CUSTOM_G4_CLAIMS[$vid]+x}" ]] && unused_g4+=("$var")
    done
    for str_id in "${CUSTOM_STRING_POOL[@]}"; do
        free_str_ids+=("0x$(printf "%04X" "$(( str_id ))")")
    done

    echo "Custom resource summary:"
    print_custom_resource_summary_line "unused reclaimed g[8] vars" "${#unused_g8[@]}" "${unused_g8[@]}"
    print_custom_resource_summary_line "unused reclaimed g[4] vars" "${#unused_g4[@]}" "${unused_g4[@]}"
    print_custom_resource_summary_line "free reclaimed str_id" "${#free_str_ids[@]}" "${free_str_ids[@]}"
}




custom_palette() {
    echo "Patching custom color palette"
    # Find palette base by signature - tested on 0401 and 0402
    local base
    base=$(find_bytes "286031BD61020000FFFFFF0096969600") || {
        echo "  custom_palette: palette signature not found"; return 1
    }
    base=$(( base + 8 ))  # first color entry

    # Selected item color
    printf '\xCC\x33\x00\x00' | patch $(( base + 0x24 ))

    # Whites
    for off in 0x00 0x1C 0x28 0x40 0x44 0x48 0x54 0x70 0x7C 0x94 0x98 0x9C ; do
        printf '\xFF\xBB\x44\x00' | patch $(( base + off ))
    done

    # Bright grays (highlights mostly)
    for off in 0x04 0x0C 0x58 0x60 0x74 ; do
        printf '\x96\x48\x48\x00' | patch $(( base + off ))
    done

    # Mid grays (buttons)
    for off in 0x08 0x5C ; do
        printf '\x64\x32\x32\x00' | patch $(( base + off ))
    done

    # Low grays (disabled, backgrounds)
    for off in 0x10 0x14 0x30 0x4C 0x64 0x68 0x84 0xA0 ; do
        printf '\x40\x20\x20\x00' | patch $(( base + off ))
    done

    # Blacks
    for off in 0x18 0x34 0x50 0x6C 0x88 0xA4 ; do
        printf '\x08\x00\x08\x00' | patch $(( base + off ))
    done
}


patch_vid_spoof() {

    # Must match Makefile VID_SPOOF_OFFSET
    local VID_SPOOF_OFFSET=0xFCFA0

    local ver=${CDX_VER#SX567-}
    local BIN=build/vid_spoof_${ver}.bin
    if [ ! -r "$BIN" ]; then
        echo "  ${FUNCNAME[0]}: $BIN not found (unsupported version or run make vid_spoof)"
        return 1
    fi
    local VTABLE_ENTRY EXPECTED_PTR
    case "$ver" in
        0401) VTABLE_ENTRY=0xF14CC; EXPECTED_PTR='\x1d\xa5\x06\x08' ;;
        0306) VTABLE_ENTRY=0xF126C; EXPECTED_PTR='\x1d\xa5\x06\x08' ;;
        0305) VTABLE_ENTRY=0xF1350; EXPECTED_PTR='\x19\xa5\x06\x08' ;;
        0302) VTABLE_ENTRY=0xF0B54; EXPECTED_PTR='\xf5\x9d\x06\x08' ;;
        0402) VTABLE_ENTRY=0xF1744; EXPECTED_PTR='\x1d\xa5\x06\x08' ;;
        *) echo "  ${FUNCNAME[0]}: skipped (unsupported CDX version $CDX_VER)"; return ;;
    esac
    if ! printf '%b' "$EXPECTED_PTR" | check_patch $VTABLE_ENTRY; then
        echo "  ${FUNCNAME[0]}: unexpected bytes at vtable entry, already patched?"
        return 1
    fi
    echo "Patching VID spoof..."
    local HOOK_FLASH=$(( VID_SPOOF_OFFSET + 0x08000000 ))
    patch_pointer "$BIN" $VID_SPOOF_OFFSET $VTABLE_ENTRY "$(le_thumb_ptr $HOOK_FLASH)"
    printf "  payload: %s at 0x%X\n" "$BIN" $VID_SPOOF_OFFSET
    printf "  vtable:  0x%X -> 0x%08X\n" $VTABLE_ENTRY $(( HOOK_FLASH | 1 ))
}



patch_lcd_ili9325() {
    # Universal ILI9325/ILI9328 + ILI9341 LCD driver.
    # Runtime detection after hardware RESET, transparent on ILI9341 boards.

    local ver=${CDX_VER#SX567-}
    local BIN=build/s10_lcd_ili9325_${ver}.bin
    local BIN_ELF=build/s10_lcd_ili9325_${ver}.elf
    if [ ! -r "$BIN" ]; then
        die "LCD patch binary not found: $BIN (run make s10_lcd_ili9325)"
    fi

    local LCD_FLASH=${S10_LCD_OFFSET:-0x080FF800}
    local LCD_OFF=$(( LCD_FLASH - 0x08000000 ))

    local BL_OFF EXPECTED_BL
    case "$CDX_VER" in
        SX567-0401|SX567-0402)
            BL_OFF=0x7C030
            EXPECTED_BL='\xFF\xF7\x7A\xFE'  # bl 0x0807BD28 (ILI9341 board init)
            ;;
        *)
            echo "  ${FUNCNAME[0]}: skipped (unsupported CDX version $CDX_VER)"
            return
            ;;
    esac

    if ! printf '%b' "$EXPECTED_BL" | check_patch "$BL_OFF"; then
        echo "  ${FUNCNAME[0]}: unexpected bytes at BL 0x${BL_OFF}"
        return 1
    fi

    echo "Patching LCD driver (ILI9325) at offset $(printf '0x%X' $LCD_OFF)"
    patch_direct "$BIN" "$LCD_OFF"

    local BOARD_INIT_ADDR
    BOARD_INIT_ADDR=$(arm-none-eabi-nm "$BIN_ELF" 2>/dev/null | awk '/lcd_board_init/{printf "0x%s", $1}')
    if [ -z "$BOARD_INIT_ADDR" ]; then
        die "  Cannot find lcd_board_init in ${BIN_ELF}"
    fi

    encode_thumb_bl "$BL_OFF" "$BOARD_INIT_ADDR" | patch "$BL_OFF"
    printf "  BL 0x%X -> 0x%08X (lcd_board_init)\n" "$BL_OFF" "$BOARD_INIT_ADDR"
}



patch_past_date() {
    # Allow setting past date in menu and UART

    echo "Patching past date restriction"

    # date direction check: cmp r0,r5 -> cmp r0,r0
    local off
    off=$(find_bytes "0098a8428041c043c00f05b030bd") || die "${FUNCNAME[0]}: date direction check not found"
    printf '\x80' | patch $(( off + 2 ))
}


patch_backlight_adapt() {
    # improved backlight response to ambient light

    local ver=${CDX_VER#SX567-}
    local BIN=build/backlight_adapt_${ver}.bin
    local BACKLIGHT_OFFSET=0xFEC00

    case "$ver" in
        0401|0402) ;;
        *) echo "  ${FUNCNAME[0]}: skipped (unsupported version $ver)"; return ;;
    esac

    if [ ! -r "$BIN" ]; then
        echo "  ${FUNCNAME[0]}: $BIN not found (run make backlight_adapt)"
        return 1
    fi

    # signature: bl A1D0; mov r0,r4; bl A2A4; movs r5,#0
    local off
    off=$(find_bytes "00F0D5F8204600F03CF90025") || {
        echo "  ${FUNCNAME[0]}: tick signature not found"
        return 1
    }

    local hook_off=$(( off + 6 ))
    local EXPECTED_BL='\x00\xF0\x3C\xF9'  # bl 0x0807A2A4, backlight state machine

    if ! printf '%b' "$EXPECTED_BL" | check_patch "$hook_off"; then
        echo "  ${FUNCNAME[0]}: unexpected bytes at hook site 0x$(printf '%X' $hook_off), already patched?"
        return 1
    fi

    echo "Patching backlight adaptation ($ver)"
    patch_direct "$BIN" $BACKLIGHT_OFFSET

    # NOP the beq that skips ASR->ASF averaging while display is active
    local gate_off=$(( off + 0x1C8 ))
    if printf '\x4F\xD0' | check_patch $gate_off ; then
        printf '\x00\xBF' | patch $gate_off
    else
        echo "  warning: ASF gate not found at expected offset"
    fi

    # redirect bl backlight_state_machine to our payload
    local cave_addr=$(( BACKLIGHT_OFFSET + 0x08000000 ))
    encode_thumb_bl "$hook_off" "$cave_addr" | patch "$hook_off"

    # tune defaults
    printf '\x20' | patch $(( $(find_var LBL) + 0x08 ))    # LBL = 32 (buttons low)
    printf '\x50' | patch $(( $(find_var LBH) + 0x08 ))    # LBH = 80 (buttons high)
    printf '\x4e\x02\x00\x00' | patch $(( $(find_var ATH) + 0x08 ))  # ATH = 590 (threshold)

    echo "  ${#BIN} at 0x$(printf '%X' $BACKLIGHT_OFFSET), hook at 0x$(printf '%X' $(( hook_off + 0x08000000 )))"
}


patch_edf_merge() {
    echo "Patching EDF signal superset"
    python3 ./python/edf_ccx_merge.py "$OUT" -o "$OUT" --force --ignore-input-crc || die "EDF merge failed"
}



motor_nagscreen () {

    local offset
    if offset=$(find_bytes "0E49884205DB03210F20") ; then
        echo "Patching \"Motor life exceeded\" nag screen"
        printf '\x05\xe0' | patch $(( offset + 4 ))
        return 0
    fi

    # fallback: find and patch runtime threshold
    echo "${FUNCNAME[0]}: BLT patch failed, trying threshold patch..."
    if offset=$(find_bytes C000B304) ; then
        echo "Patching \"Motor life exceeded\" threshold"
        printf '\xFF\xFF\xFF\x7F' | patch $offset
        return 0
    fi

    echo "${FUNCNAME[0]}: neither patch location found!"
    return 1
}



