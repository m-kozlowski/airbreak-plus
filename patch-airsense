#!/bin/bash

die() { echo >&2 "$*" ; exit 1 ; }

IN=$1
OUT=$2

FLASH_BASE=0x08000000
BID_OFFSET=0x3F80
GLOBALS_REL=0x108

DEBUG_PATCH=""

read_bytes() {
    # args: offset length -> raw bytes on stdout
    perl -e '
        open my $fh, "<:raw", $ARGV[0] or die "open: $!";
        seek($fh, $ARGV[1], 0) or die "seek: $!";
        read($fh, my $buf, $ARGV[2]) == $ARGV[2] or die "short read";
        print $buf;
    ' "$OUT" "$(printf "%d" "$1")" "$(printf "%d" "$2")"
}

detect_platform() {
    BID=$(read_bytes "$BID_OFFSET" 16 | tr -d '\0')

    case "$BID" in
        SX577-0200*)
            BLX_OFF=0x00000; BLX_SIZE=0x04000
            CCX_OFF=0x04000; CCX_SIZE=0x3C000
            CDX_OFF=0x40000; CDX_SIZE=0xC0000
            ;;
        SX585-0200*)
            BLX_OFF=0x00000; BLX_SIZE=0x04000
            CCX_OFF=0x04000; CCX_SIZE=0x1C000
            CDX_OFF=0x20000; CDX_SIZE=0xE0000
            ;;
        *)
            die "Unknown bootloader ID: '$BID'"
            ;;
    esac

    GLOBALS_ADDR=$(( CCX_OFF + GLOBALS_REL ))
    CDX_VER=$(read_bytes "$CDX_OFF" 16 | tr -d '\0')

    echo "Bootloader ID:  $BID"
    echo "CDX Version:    $CDX_VER"
}

if [ -z "$IN" -o -z "$OUT" ]; then
    die "Usage: $0: stm32.bin stm32-unlocked.bin"
fi


if [ ! -r "$IN" ]; then
    die "$IN: can not open input file"
fi

patch() {
    offset=`printf "%d" $1`
    if [ $DEBUG_PATCH ] ; then
        printf "patching %08x\n" $1
    fi
    dd bs=1 seek=$offset conv=notrunc of="$OUT" status=none
}

fill_ff() {
    local size=$(printf "%d" "$2")
    perl -e 'print "\xff" x $ARGV[0]' "$size" | patch "$1"
}

check_patch ()
{
    offset=$(printf "%d" "$1");
    tmp=$(mktemp) || return 2;
    cat > "$tmp";
    size=$(stat -c %s "$tmp");
    if dd if="$OUT" bs=1 skip="$offset" count="$size" status=none | cmp -s - "$tmp"; then
        rm -f "$tmp";
        return 0;
    else
        rm -f "$tmp";
        return 1;
    fi
}


crc16_region() {
    # args: offset length
    local offset=$(printf "%d" "$1")
    local length=$(printf "%d" "$2")

    perl -e '
        use strict;
        use warnings;

        my @table;
        for my $i (0..255) {
            my $c = $i << 8;
            for (1..8) {
                $c = ($c & 0x8000) ? (($c << 1) ^ 0x1021) & 0xFFFF : ($c << 1) & 0xFFFF;
            }
            $table[$i] = $c;
        }

        open my $fh, "<:raw", $ARGV[0] or die "open: $!";
        seek($fh, $ARGV[1], 0) or die "seek: $!";

        my $remaining = $ARGV[2];
        my $crc = 0xFFFF;
        while ($remaining > 0) {
            my $n = $remaining > 65536 ? 65536 : $remaining;
            my $got = read($fh, my $buf, $n);
            defined $got && $got == $n or die "read: $!";
            foreach my $byte (unpack("C*", $buf)) {
                $crc = (($crc << 8) & 0xFFFF) ^ $table[(($crc >> 8) ^ $byte) & 0xFF];
            }
            $remaining -= $n;
        }

        printf "%04X\n", $crc;
    ' "$OUT" "$offset" "$length"
}

find_bytes() {
    # return values:
    # 0: single address found (print on stdout)
    # 1: not found
    # 2: >1 ocurrences found
    local hex="$1"
    perl -0777 -e '
        my ($file, $hex) = @ARGV;

        open my $fh, "<:raw", $file or exit 1;
        local $/;
        my $data = <$fh>;

        my $pattern = pack("H*", $hex);

        my @pos;
        my $i = 0;
        while (($i = index($data, $pattern, $i)) != -1) {
            push @pos, $i;
            $i++;
            last if @pos > 1;
        }

        if (@pos == 1) {
            print "$pos[0]\n";
            exit 0;
        } elsif (@pos > 1) {
            exit 2;
        } else {
            exit 1;
        }
    ' "$OUT" "$hex"
}

# read a little-endian u32 from file offset in $OUT
read_u32() {
    read_bytes "$1" 4 | perl -e 'read(STDIN, my $b, 4) == 4 or exit 1;
        printf "%d\n", unpack("V", $b)'
}

is_flash_ptr() {
    local ptr=$(printf "%d" "$1")
    local size=$(stat -c %s "$OUT")
    (( ptr >= FLASH_BASE && ptr < FLASH_BASE + size ))
}

declare -A _globals_cache

# return the absolute pointer stored in globals[$1]
globals_ptr() {
    local idx=$1
    local off=$(( GLOBALS_ADDR + idx * 4 ))
    read_u32 $off
}

# return the file offset for the data that pointer points to
globals_offset() {
    if [[ -z "${_globals_cache[$1]+x}" ]]; then
        local ptr
        ptr=$(globals_ptr "$1") || return 1
        _globals_cache[$1]=$(( ptr - FLASH_BASE ))
    fi
    echo "${_globals_cache[$1]}"
}

declare -A _var_by_name
declare -A _var_id_present
declare -a _var_id_list
_uart_names_loaded=0

load_uart_names() {
    [[ "$_uart_names_loaded" == 1 ]] && return 0

    local g23
    g23=$(globals_offset 23) || die "globals[23] not found"

    # globals[23] is a 26-bucket UART-name lookup table:
    # each bucket points to {char2, char3, var_id} entries for one first letter.
    while IFS=$'\t' read -r name vid; do
        [[ -n "$name" && -n "$vid" ]] || continue
        _var_by_name[$name]=$vid
        local vid_dec=$((vid))
        if [[ -z "${_var_id_present[$vid_dec]+x}" ]]; then
            _var_id_present[$vid_dec]=1
            _var_id_list+=("$vid_dec")
        fi
    done < <(
        perl -e '
            use strict;
            use warnings;

            my ($file, $g23, $flash_base) = @ARGV;
            $g23 += 0;
            $flash_base = oct($flash_base);

            open my $fh, "<:raw", $file or die "open: $!";
            local $/;
            my $data = <$fh>;
            my $len = length($data);

            my $u32 = sub {
                my ($off) = @_;
                return undef if $off < 0 || $off + 4 > $len;
                return unpack("V", substr($data, $off, 4));
            };

            for my $letter_idx (0..25) {
                my $off = $g23 + $letter_idx * 8;
                my $sub_ptr = $u32->($off);
                my $count = $u32->($off + 4);
                next if !defined($sub_ptr) || !defined($count) || $count > 200;

                my $sub_off = $sub_ptr - $flash_base;
                next if $sub_off < 0 || $sub_off + $count * 4 > $len;

                for my $j (0..$count - 1) {
                    my ($c2, $c3, $vid) = unpack("C C v", substr($data, $sub_off + $j * 4, 4));
                    printf "%s%c%c\t0x%04X\n", chr(ord("A") + $letter_idx), $c2, $c3, $vid;
                }
            }
        ' "$OUT" "$g23" "$FLASH_BASE"
    )

    _uart_names_loaded=1
}

declare -A _var_table_stride=([3]=10 [4]=0x1C [6]=0x18 [8]=0x14 [9]=0x18)
declare -A _var_table_base
declare -A _var_table_count
declare -A _var_table_id_base
_var_tables_loaded=0

next_global_offset_after() {
    local base_off=$(printf "%d" "$1")
    local base_ptr=$(( FLASH_BASE + base_off ))
    local best=

    for idx in {0..29}; do
        local ptr
        ptr=$(globals_ptr "$idx") || continue
        if is_flash_ptr "$ptr" && (( ptr > base_ptr )); then
            if [[ -z "$best" || ptr -lt best ]]; then
                best=$ptr
            fi
        fi
    done

    [[ -n "$best" ]] || return 1
    echo $(( best - FLASH_BASE ))
}

zero_padding() {
    read_bytes "$1" "$2" | perl -e 'local $/; my $b = <STDIN>; exit($b =~ /[^\x00]/ ? 1 : 0)'
}

var_table_count() {
    local tnum=$1
    local base=$(printf "%d" "$2")
    local stride=$(printf "%d" "$3")
    local end size rem count

    end=$(next_global_offset_after "$base") || die "cannot infer globals[$tnum] end"
    size=$(( end - base ))
    (( size > 0 )) || die "globals[$tnum] size $size is invalid"

    rem=$(( size % stride ))
    if (( rem != 0 )); then
        count=$(( size / stride ))
        # Older builds can align the next table after g[3] with a short zero pad.
        if (( tnum == 3 && rem < 4 && count > 0 )) && zero_padding $(( base + count * stride )) "$rem"; then
            echo "$count"
            return
        fi
        die "globals[$tnum] size 0x$(printf "%X" "$size") is not aligned to stride 0x$(printf "%X" "$stride")"
    fi

    echo $(( size / stride ))
}

has_id_range() {
    local start=$(printf "%d" "$1")
    local count=$(printf "%d" "$2")
    local i

    for (( i = 0; i < count; i++ )); do
        [[ -n "${_var_id_present[$(( start + i ))]+x}" ]] || return 1
    done
    return 0
}

infer_var_table_id_base() {
    local tnum=$1
    local count=$(printf "%d" "$2")
    local expected=${3-}

    if [[ -n "$expected" ]]; then
        expected=$(printf "%d" "$expected")
        if has_id_range "$expected" "$count"; then
            echo "$expected"
            return
        fi
        die "globals[$tnum] var_id range 0x$(printf "%04X" "$expected")..0x$(printf "%04X" $(( expected + count - 1 ))) missing from globals[23]"
    fi

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        if [[ -n "${_var_id_present[$(( candidate - 1 ))]+x}" ]]; then
            continue
        fi
        if has_id_range "$candidate" "$count"; then
            echo "$candidate"
            return
        fi
    done < <(printf "%s\n" "${_var_id_list[@]}" | sort -n)

    die "cannot infer globals[$tnum] var_id base from globals[23]"
}

load_var_tables() {
    [[ "$_var_tables_loaded" == 1 ]] && return 0
    load_uart_names

    local expected=
    for tnum in 3 4 6 8 9; do
        local ptr base stride count id_base
        ptr=$(globals_ptr "$tnum") || die "globals[$tnum] not found"
        is_flash_ptr "$ptr" || continue

        base=$(( ptr - FLASH_BASE ))
        stride=${_var_table_stride[$tnum]}
        count=$(var_table_count "$tnum" "$base" "$stride")
        id_base=$(infer_var_table_id_base "$tnum" "$count" "$expected")

        _var_table_base[$tnum]=$base
        _var_table_count[$tnum]=$count
        _var_table_id_base[$tnum]=$id_base
        expected=$(( id_base + count ))
    done

    _var_tables_loaded=1
}

# Descriptor lookup: returns file offset of a variable record for numeric var_id.
find_var_id() {
    local vid=$(printf "%d" "$1")
    load_var_tables

    for tnum in 3 4 6 8 9; do
        [[ -n "${_var_table_base[$tnum]+x}" ]] || continue

        local base=${_var_table_base[$tnum]}
        local count=${_var_table_count[$tnum]}
        local id_base=${_var_table_id_base[$tnum]}
        local stride=${_var_table_stride[$tnum]}

        if (( vid >= id_base && vid < id_base + count )); then
            echo $(( base + (vid - id_base) * stride ))
            return
        fi
    done

    die "find_var_id: var_id $1 not in derived descriptor tables"
}

# UART name lookup: returns numeric var_id
find_var_id_by_name() {
    load_uart_names
    local name=${1^^}
    local vid=${_var_by_name[$name]}
    [[ -n "$vid" ]] || die "unknown UART variable name: $1"
    echo "$vid"
}

# Accept UART names, decimal ids, or hex ids and return normalized numeric var_id.
resolve_var_id() {
    if [[ "$1" == 0x* || "$1" =~ ^[0-9]+$ ]]; then
        printf "0x%04X\n" "$(printf "%d" "$1")"
    else
        find_var_id_by_name "$1"
    fi
}

# Descriptor lookup by UART name.
find_var_name() {
    find_var_id "$(find_var_id_by_name "$1")"
}

# Smart descriptor lookup by UART name or numeric id.
find_var() {
    find_var_id "$(resolve_var_id "$1")"
}


cp "$IN" "$OUT" || die "$OUT: copy failed"
detect_platform
# Many patch sites call find_var through command substitution; preload in the parent shell.
load_var_tables

deprecated() {
    if [[ $FORCE_DEPRECATED != 1 ]]; then
        echo "SKIP: ${FUNCNAME[1]}:"
        for line in "$@"; do echo "  $line"; done
        return 0
    fi
    echo "WARN: ${FUNCNAME[1]}: applying deprecated patch"
    return 1
}

patch_tamper() {
    echo -n "Patching firmware integrity checks... "
    case "$BID" in
        SX577-0200*)
            printf '\x01\x20\xc0\x46' | patch 0x310e && echo -n "BLX ok " || die "patch failed (BLX)"
            printf '\x00\x20\xc0\x46' | patch 0x313e && echo -n "CCX ok " || die "patch failed (CCX)"
            printf '\x00\x20\xc0\x46' | patch 0x3130 && echo -n "CDX ok " || die "patch failed (CDX)"
            ;;
        SX585-0200*)
            printf '\x01\x20\xc0\x46' | patch 0x316e && echo -n "BLX ok " || die "patch failed (BLX)"
            printf '\x00\x20\xc0\x46' | patch 0x319e && echo -n "CCX ok " || die "patch failed (CCX)"
            printf '\x00\x20\xc0\x46' | patch 0x3190 && echo -n "CDX ok " || die "patch failed (CDX)"
            ;;
        *)
            die "Unknown bootloader ID: '$BID'"
            # or try previous method if you know what you're doing
            # printf '\xc0\x46' | patch 0xf0 || die "startup patch failed"
            ;;
    esac
    echo
}

patch_psu_id() {
    echo -n "Patching Power Supply ID check... "
    case "$BID" in
        SX577-0200*)
            printf '\x00\x20\x70\x47' | patch 0x2882 && echo -n "ok" || die "patch failed"
            ;;
        *)
            echo "skipped (unsupported bootloader version $BID)"
            ;;
    esac
    echo
}


patch_direct() {
    BIN_FILE=$1
    ADDR=$2
    if [ -r $BIN_FILE ] ; then
        printf "Including $BIN_FILE..."
        cat $BIN_FILE | patch $ADDR || die " patching failed"
        echo " success!"
    else
        die " file not found, did you run make?"
    fi
}

# BIN_FILE - file
# ADDR - address in the patched binary to point to
# PTR_ADDR - address of the +1 pointer in the binary
# PTR_TARGET is +1 relative to ADDR, and byte order is reversed(little-endian)
patch_pointer() {
    BIN_FILE=$1
    ADDR=$2
    PTR_ADDR=$3
    PTR_TARGET=$4
    if [ -r $BIN_FILE ]; then
        printf "Including $BIN_FILE..."
        cat $BIN_FILE | patch $ADDR || die " patching failed"
        printf "$PTR_TARGET" | patch $PTR_ADDR || die " pointer fixup failed"
        echo " success!"
    fi
}

# Convert address to a little-endian Thumb pointer string for patch_pointer
le_thumb_ptr() {
    local addr=$(printf "%d" "$1")
    local thumb=$(( addr | 1 ))
    printf '\\x%02x\\x%02x\\x%02x\\x%02x' \
        $((thumb & 0xFF)) \
        $(((thumb >> 8) & 0xFF)) \
        $(((thumb >> 16) & 0xFF)) \
        $(((thumb >> 24) & 0xFF))
}

# encode_thumb_bl SRC_FILE_OFF DST_FLASH_ADDR
encode_thumb_bl() {
    python3 -c "
import struct, sys
src = $1 + 0x08000004
dst = $2
offset = dst - src
S = 1 if offset < 0 else 0
if offset < 0: offset += (1 << 25)
I1 = (offset >> 23) & 1; I2 = (offset >> 22) & 1
imm10 = (offset >> 12) & 0x3FF; imm11 = (offset >> 1) & 0x7FF
J1 = (~(I1 ^ S)) & 1; J2 = (~(I2 ^ S)) & 1
hw1 = 0xF000 | (S << 10) | imm10
hw2 = 0xD000 | (J1 << 13) | (J2 << 11) | imm11
sys.stdout.buffer.write(struct.pack('<HH', hw1, hw2))
"
}

patch_code_common() {
    local ver=${CDX_VER#SX567-}
    local BIN=build/common_code_${ver}.bin
    echo "Patching common_code.c ($ver)"
    patch_direct "$BIN" 0xfd800
}

patch_code_graph() {
    local ver=${CDX_VER#SX567-}
    local BIN=build/graph_${ver}.bin
    local FPTR
    case "$ver" in
        0401) FPTR=0xf9c88 ;;
        0402) FPTR=0xf9f00 ;;
        *) echo "  patch_code_graph: unsupported $ver"; return 1 ;;
    esac
    echo "Patching graphing code ($ver)"
    patch_pointer "$BIN" 0xfd000 "$FPTR" "$(le_thumb_ptr 0x80fd000)"
}

patch_code_squarewave() {
    local ver=${CDX_VER#SX567-}
    local BIN=build/squarewave_${ver}.bin
    local FPTR
    case "$ver" in
        0401) FPTR=0xf9778 ;;
        0402) FPTR=0xf99f0 ;;
        *) echo "  patch_code_squarewave: unsupported $ver"; return 1 ;;
    esac
    echo "Patching Squarewave ($ver)"
    patch_pointer "$BIN" 0xfd400 "$FPTR" "$(le_thumb_ptr 0x80fd400)"
}

patch_code_asv_task_wraper() {
    local ver=${CDX_VER#SX567-}
    local BIN=build/asv_task_wrapper_${ver}.bin
    local FPTR
    case "$ver" in
        0401|0306) FPTR=0xf44e0 ;;
        0402) FPTR=0xf4758 ;;
        *) echo "  patch_code_asv_task_wraper: unsupported $ver"; return 1 ;;
    esac
    echo "Patching ASV task wrapper ($ver)"
    patch_pointer "$BIN" 0xfd700 "$FPTR" "$(le_thumb_ptr 0x80fd700)"
}

patch_wrapper_limit_max_pdiff() {
    local ver=${CDX_VER#SX567-}
    local BIN=build/wrapper_limit_max_pdiff_${ver}.bin
    local FPTR
    case "$ver" in
        0401) FPTR=0xf93d0 ;;
        0402) FPTR=0xf9648 ;;
        *) echo "  patch_wrapper_limit_max_pdiff: unsupported $ver"; return 1 ;;
    esac
    echo "Patching wrapper for pressure_limit_max_diff ($ver)"
    patch_pointer "$BIN" 0xff000 "$FPTR" "$(le_thumb_ptr 0x80ff000)"
}

patch_code() {
    if [[ $PATCH_CODE == 1 ]] ; then
        case "$CDX_VER" in
            SX567-0401*|SX567-0402*) ;;
            *) echo "  patch_code: skipped (unsupported CDX version $CDX_VER)"; return ;;
        esac
        echo "Patching code"
        patch_code_common
        patch_code_graph
        if [[ $PATCH_S == 1 ]] ; then
            patch_code_squarewave
        fi
        if [[ $PATCH_ASV_TASK_WRAPPER == 1 ]] ; then
            patch_code_asv_task_wraper
        fi
        if [[ $PATCH_VAUTO_WRAPPER == 1 ]] ; then
            patch_wrapper_limit_max_pdiff
        fi
    fi
}

unlock_ui_limits() {
    # patch UI pressure limits to range between 1 and 30
    # Entry4 record layout: +0x0C = max (u32), +0x10 = min (u32)

    echo "Patching UI limits"

    local G4_MAX=0x0C
    local vars=(
        IPC # Set Pressure (CPAP)
        MPA # Max Pressure (AutoSet, APAP, AfH)
        IPP # IPAP (S, ST, T, PAC)
        STP # Start Pressure (CPAP)
        MPI # Min Pressure (AutoSet, APAP, AfH)
        STU # Start Pressure (AutoSet, APAP, AfH)
        MNE # Min EPAP (VAuto)
        MXI # Max IPAP (VAuto)
        STV # Start EPAP (VAuto)
        EPP # EPAP (S, ST)
        EPS # Start EPAP (S, ST, PAC)
        EEP # EPAP (ASV)
        STE # Start EPAP (ASV)
        EAX # Max EPAP (ASVAuto)
        EAI # Min EPAP (ASVAuto)
        EAS # Start EPAP (ASVAuto)
        EPI # EPAP (iVAPS)
        IVS # Start EPAP (iVAPS)
    )

    for var in "${vars[@]}"; do
        # max=0x000005DC (1500) min=0x00000032 (50) scale=1/50
        printf '\xdc\x05\x00\x00\x32\x00\x00\x00' | patch $(( $(find_var "$var") + G4_MAX )) || die failed
    done
}

asv_unlock_ps_range () {
    # Disable the ASV and ASVAuto PS range check to allow Max PS < (Min PS + 5)
    # and remove the fixed ASV EPAP ceiling of MCP - 6.0 cmH2O.

    echo "Unlocking ASV pressure constraints"

    case "$CDX_VER" in
        SX567-0401|SX567-0306|SX567-0402)
            printf '\xa0\xf1\x00\x01' | patch 0x76bd6  # EEP.max: MCP - 6.0 -> MCP             ; sub.w r1, r0, #0x12c -> #0x00
            printf '\x00' | patch 0x76c08              # MXS.min: MNS + 5.0 -> MNS             ; add.w r1, r0, #0xfa -> #0x00
            printf '\x00' | patch 0x76c34              # MNS.max: MCP - EEP - 5.0 -> MCP - EEP ; sub.w r1, r0, #0xfa -> #0x00
            printf '\x00' | patch 0x76cca              # AXS.min: ANS + 5.0 -> ANS             ; add.w r1, r0, #0xfa -> #0x00
            ;;
        SX567-0305)
            printf '\xa0\xf1\x00\x01' | patch 0x76bda
            printf '\x00' | patch 0x76c0c
            printf '\x00' | patch 0x76c38
            printf '\x00' | patch 0x76cce
            ;;
        SX567-0302)
            printf '\xa0\xf1\x00\x01' | patch 0x76462
            printf '\x00' | patch 0x76494
            printf '\x00' | patch 0x764c0
            printf '\x00' | patch 0x76556
            ;;
        *)
            echo "  asv_unlock_ps_range: CDX code patches skipped (unsupported CDX version $CDX_VER)"
            ;;
    esac

    local G4_MAX=0x0C
    local G4_MIN=0x10
    for var in MNS MXS ANS AXS; do
        # min = 0
        printf '\x00\x00\x00\x00' | patch $(( $(find_var "$var") + G4_MIN ))
        # max = 1250 = 25.0 cmH2O
        printf '\xe2\x04\x00\x00' | patch $(( $(find_var "$var") + G4_MAX ))
    done
}

extra_debug() {
    echo "Enabling extra info on therapy screen"
    # set config variable 0xc value to 4 == enable more debugging data on display
    # Default in VAuto is \x0e, all enabled is \x0f
    # 1000 - ti min, ti max, ti, I:E, spont cyc (doesn't fit graph)
    # 0100 - leak MV, RR, tv (default in this script)
    # 0010 - bar thingy
    # 0001 - fancy but useless round display

    local G6_DEFAULT=0x08
    printf '\x0e' | patch $(( $(find_var TSS) + G6_DEFAULT )) || die failed
}

extra_modes() {
    echo "Enabling all therapy modes"
    # add more mode entries, set config 0x0 mask to all bits high
    # AutoSet default is 0x3, which only enables mode 1 (CPAP) and 2 (AutoSet)
    # Autoset = 03 00, For Her = 03 08
    # 1. 1 = CPAP
    # 2. 2 = AutoSet
    # 3. 4 = ???
    # 4. 8 = S
    # 5. 16 = ???
    # 6. 32 = ???
    # 7, 64 = VAuto
    # 8, 128 = ASV
    # 9, 256 = ASVAuto
    # 49 00 = 0x01001001 = CPAP, VAuto, S
    # 81 01 = 0x10000001 = CPAP, ASV, ASVAuto
    # 2048 = AutoSet for her?

    local G8_BITMASK=0x0C
    printf '\xff\xff' | patch $(( $(find_var MOP) + G8_BITMASK )) || die failed
}

unlock_option_masks() {
    echo "Unlocking option masks"

    local G8_BITMASK=0x0C
    local masks=(
        "TBT 0x00000007" # Tube: SlimLine, Standard, 3m
        "RMA 0x00000007" # Ramp: Off, On, Auto
    )

    local entry name mask
    for entry in "${masks[@]}"; do
        read -r name mask <<< "$entry"
        perl -e 'print pack("V", oct($ARGV[0]))' "$mask" | \
            patch $(( $(find_var "$name") + G8_BITMASK )) || die failed
    done
}

