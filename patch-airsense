patch_code_squarewave() {
    local ver=${CDX_VER#SX567-}
    local CODE_OFF=0xfd400
    local BIN=build/squarewave_${ver}.bin
    local ELF=build/squarewave_${ver}.elf
    local FPTR original_slot original payload_thumb
    case "$ver" in
        0401) FPTR=0xf9778 ;;
        0402) FPTR=0xf99f0 ;;
        *) echo "  patch_code_squarewave: unsupported $ver"; return 1 ;;
    esac
    echo "Patching Squarewave ($ver)"
    [[ -r "$ELF" ]] || die "patch_code_squarewave: $ELF not found"
    original_slot=$(elf_symbol_addr "$ELF" squarewave_original_handler)
    payload_thumb=$(( FLASH_BASE + CODE_OFF + 1 ))
    original=$(read_u32 "$FPTR")
    if (( original == payload_thumb )); then
        original=$(read_u32 $(( original_slot - FLASH_BASE )))
    fi
    patch_pointer "$BIN" "$CODE_OFF" "$FPTR" "$(le_thumb_ptr $(( FLASH_BASE + CODE_OFF )))"
    write_u32 $(( original_slot - FLASH_BASE )) "$original" || die failed
    printf "  original handler: 0x%08X -> ABI 0x%08X\n" "$original" "$original_slot"
}


