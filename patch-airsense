#!/bin/bash

set -euo pipefail


die() { echo >&2 "$*"; exit 1; }


IN=${1:-}
OUT=${2:-}

if [[ -z "$IN" || -z "$OUT" ]]; then
    die "Usage: $0 input.bin output.bin [Python patch options]"
fi

if [[ ! -r "$IN" ]]; then
    die "$IN: can not open input file"
fi

shift 2

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PYTHON=${PYTHON:-python3}
PATCHER="$SCRIPT_DIR/python/patch-airsense.py"

if [[ ! -r "$PATCHER" ]]; then
    die "$PATCHER: can not open Python patcher"
fi


exec "$PYTHON" "$PATCHER" "$IN" "$OUT" PATCH --overwrite "$@"
