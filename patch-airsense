#!/bin/bash

die() { echo >&2 "$*" ; exit 1 ; }

IN=$1
OUT=$2

FLASH_BASE=0x08000000
BID_OFFSET=0x3F80
GLOBALS_REL=0x108

DEBUG_PATCH=""


# -----------------------------------------------------------------------------
# Core patching framework
# -----------------------------------------------------------------------------


# Print raw bytes from the output image.
# args: offset length
read_bytes() {
    perl -e '
        open my $fh, "<:raw", $ARGV[0] or die "open: $!";
        seek($fh, $ARGV[1], 0) or die "seek: $!";
        read($fh, my $buf, $ARGV[2]) == $ARGV[2] or die "short read";
        print $buf;
    ' "$OUT" "$(printf "%d" "$1")" "$(printf "%d" "$2")"
}


detect_platform() {
    BID=$(read_bytes "$BID_OFFSET" 16 | tr -d '\0')

    case "$BID" in
        SX577-0200*)
            BLX_OFF=0x00000; BLX_SIZE=0x04000
            CCX_OFF=0x04000; CCX_SIZE=0x3C000
            CDX_OFF=0x40000; CDX_SIZE=0xC0000
            ;;
        SX585-0200*)
            BLX_OFF=0x00000; BLX_SIZE=0x04000
            CCX_OFF=0x04000; CCX_SIZE=0x1C000
            CDX_OFF=0x20000; CDX_SIZE=0xE0000
            ;;
        *)
            die "Unknown bootloader ID: '$BID'"
            ;;
    esac

    GLOBALS_ADDR=$(( CCX_OFF + GLOBALS_REL ))
    CDX_VER=$(read_bytes "$CDX_OFF" 16 | tr -d '\0')

    echo "Bootloader ID:  $BID"
    echo "CDX Version:    $CDX_VER"
}


patch() {
    offset=`printf "%d" $1`
    if [ $DEBUG_PATCH ] ; then
        printf "patching %08x\n" $1
    fi
    dd bs=1 seek=$offset conv=notrunc of="$OUT" status=none
}


check_patch () {
    offset=$(printf "%d" "$1");
    tmp=$(mktemp) || return 2;
    cat > "$tmp";
    size=$(stat -c %s "$tmp");
    if dd if="$OUT" bs=1 skip="$offset" count="$size" status=none | cmp -s - "$tmp"; then
        rm -f "$tmp";
        return 0;
    else
        rm -f "$tmp";
        return 1;
    fi
}


# Overwrite range with repeated byte.
# args: offset size byte
fill_range() {
    local offset=$(printf "%d" "$1")
    local size=$(printf "%d" "$2")
    local byte=$(printf "%d" "$3")
    perl -e '
        my ($file, $off, $size, $byte) = @ARGV;
        open my $fh, "+<:raw", $file or die "open: $!";
        seek($fh, $off, 0) or die "seek: $!";
        print $fh chr($byte) x $size;
    ' "$OUT" "$offset" "$size" "$byte"
}


# Test whether every byte in range equals byte.
# args: offset size byte
range_is_byte() {
    local offset=$(printf "%d" "$1")
    local size=$(printf "%d" "$2")
    local byte=$(printf "%d" "$3")
    perl -e '
        my ($file, $off, $size, $byte) = @ARGV;
        open my $fh, "<:raw", $file or die "open: $!";
        seek($fh, $off, 0) or die "seek: $!";
        my $want = chr($byte);
        while ($size > 0) {
            my $chunk = $size > 65536 ? 65536 : $size;
            my $got = read($fh, my $buf, $chunk);
            exit 1 if !defined($got) || $got != $chunk || $buf ne ($want x $got);
            $size -= $got;
        }
    ' "$OUT" "$offset" "$size" "$byte"
}


# Overwrite range with 0xFF.
# args: offset size
fill_ff() {
    fill_range "$1" "$2" 0xff
}


# Test whether range is all zero bytes.
# args: offset size
zero_padding() {
    range_is_byte "$1" "$2" 0
}


# Calculate CRC-16 over an output image range.
# args: offset length
crc16_region() {
    local offset=$(printf "%d" "$1")
    local length=$(printf "%d" "$2")

    perl -e '
        use strict;
        use warnings;

        my @table;
        for my $i (0..255) {
            my $c = $i << 8;
            for (1..8) {
                $c = ($c & 0x8000) ? (($c << 1) ^ 0x1021) & 0xFFFF : ($c << 1) & 0xFFFF;
            }
            $table[$i] = $c;
        }

        open my $fh, "<:raw", $ARGV[0] or die "open: $!";
        seek($fh, $ARGV[1], 0) or die "seek: $!";

        my $remaining = $ARGV[2];
        my $crc = 0xFFFF;
        while ($remaining > 0) {
            my $n = $remaining > 65536 ? 65536 : $remaining;
            my $got = read($fh, my $buf, $n);
            defined $got && $got == $n or die "read: $!";
            foreach my $byte (unpack("C*", $buf)) {
                $crc = (($crc << 8) & 0xFFFF) ^ $table[(($crc >> 8) ^ $byte) & 0xFF];
            }
            $remaining -= $n;
        }

        printf "%04X\n", $crc;
    ' "$OUT" "$offset" "$length"
}


find_bytes() {
    # return values:
    # 0: single address found (print on stdout)
    # 1: not found
    # 2: >1 ocurrences found
    local hex="$1"
    perl -0777 -e '
        my ($file, $hex) = @ARGV;

        open my $fh, "<:raw", $file or exit 1;
        local $/;
        my $data = <$fh>;

        my $pattern = pack("H*", $hex);

        my @pos;
        my $i = 0;
        while (($i = index($data, $pattern, $i)) != -1) {
            push @pos, $i;
            $i++;
            last if @pos > 1;
        }

        if (@pos == 1) {
            print "$pos[0]\n";
            exit 0;
        } elsif (@pos > 1) {
            exit 2;
        } else {
            exit 1;
        }
    ' "$OUT" "$hex"
}


# read a little-endian u32 from file offset in $OUT
read_u32() {
    read_bytes "$1" 4 | perl -e 'read(STDIN, my $b, 4) == 4 or exit 1;
        printf "%d\n", unpack("V", $b)'
}


read_u8() {
    read_bytes "$1" 1 | perl -e 'read(STDIN, my $b, 1) == 1 or exit 1;
        printf "%d\n", unpack("C", $b)'
}


read_u16() {
    read_bytes "$1" 2 | perl -e 'read(STDIN, my $b, 2) == 2 or exit 1;
        printf "%d\n", unpack("v", $b)'
}


# Write little-endian u8.
# args: offset value
write_u8() {
    perl -e 'my $v = $ARGV[0] =~ /^0/ ? oct($ARGV[0]) : int($ARGV[0]); print pack("C", $v)' "$2" | patch "$1"
}


# Write little-endian u16.
# args: offset value
write_u16() {
    perl -e 'my $v = $ARGV[0] =~ /^0/ ? oct($ARGV[0]) : int($ARGV[0]); print pack("v", $v)' "$2" | patch "$1"
}


# Write little-endian u32.
# args: offset value
write_u32() {
    perl -e 'my $v = $ARGV[0] =~ /^0/ ? oct($ARGV[0]) : int($ARGV[0]); print pack("V", $v)' "$2" | patch "$1"
}


is_flash_ptr() {
    local ptr=$(printf "%d" "$1")
    local size=$(stat -c %s "$OUT")
    (( ptr >= FLASH_BASE && ptr < FLASH_BASE + size ))
}


# Include a built binary at a file offset.
# args: binary file, destination file offset
patch_direct() {
    BIN_FILE=$1
    ADDR=$2
    if [ -r $BIN_FILE ] ; then
        printf "Including $BIN_FILE..."
        cat $BIN_FILE | patch $ADDR || die " patching failed"
        echo " success!"
    else
        die " file not found, did you run make?"
    fi
}


# Include a built binary and patch a pointer to its Thumb entry.
# args: binary file, payload offset, pointer offset, little-endian Thumb pointer bytes
patch_pointer() {
    BIN_FILE=$1
    ADDR=$2
    PTR_ADDR=$3
    PTR_TARGET=$4
    if [ -r $BIN_FILE ]; then
        printf "Including $BIN_FILE..."
        cat $BIN_FILE | patch $ADDR || die " patching failed"
        printf "$PTR_TARGET" | patch $PTR_ADDR || die " pointer fixup failed"
        echo " success!"
    fi
}


# Convert address to a little-endian Thumb pointer string for patch_pointer
le_thumb_ptr() {
    local addr=$(printf "%d" "$1")
    local thumb=$(( addr | 1 ))
    printf '\\x%02x\\x%02x\\x%02x\\x%02x' \
        $((thumb & 0xFF)) \
        $(((thumb >> 8) & 0xFF)) \
        $(((thumb >> 16) & 0xFF)) \
        $(((thumb >> 24) & 0xFF))
}


# Return a linked flash symbol address from an ELF.
# args: elf path, symbol name
elf_symbol_addr() {
    local elf=$1 sym=$2 addr
    addr=$(arm-none-eabi-nm "$elf" 2>/dev/null | awk -v sym="$sym" '$3 == sym { printf "0x%s", $1; found=1 } END { if (!found) exit 1 }')
    [[ -n "$addr" ]] || die "elf_symbol_addr: symbol $sym not found in $elf"
    printf "%s" "$addr"
}


# Encode a Thumb BL instruction.
# args: source file offset, destination flash address
encode_thumb_bl() {
    python3 -c "
import struct, sys
src = $1 + 0x08000004
dst = $2
offset = dst - src
S = 1 if offset < 0 else 0
if offset < 0: offset += (1 << 25)
I1 = (offset >> 23) & 1; I2 = (offset >> 22) & 1
imm10 = (offset >> 12) & 0x3FF; imm11 = (offset >> 1) & 0x7FF
J1 = (~(I1 ^ S)) & 1; J2 = (~(I2 ^ S)) & 1
hw1 = 0xF000 | (S << 10) | imm10
hw2 = 0xD000 | (J1 << 13) | (J2 << 11) | imm11
sys.stdout.buffer.write(struct.pack('<HH', hw1, hw2))
"
}


# Check that a target patch range is still erased.
# args: offset size
check_ff() {
    range_is_byte "$1" "$2" 0xff
}


deprecated() {
    if [[ $FORCE_DEPRECATED != 1 ]]; then
        echo "SKIP: ${FUNCNAME[1]}:"
        for line in "$@"; do echo "  $line"; done
        return 0
    fi
    echo "WARN: ${FUNCNAME[1]}: applying deprecated patch"
    return 1
}


# return the absolute pointer stored in globals[$1]
globals_ptr() {
    local idx=$1
    local off=$(( GLOBALS_ADDR + idx * 4 ))
    read_u32 $off
}


# return the file offset for the data that pointer points to
globals_offset() {
    if [[ -z "${_globals_cache[$1]+x}" ]]; then
        local ptr
        ptr=$(globals_ptr "$1") || return 1
        _globals_cache[$1]=$(( ptr - FLASH_BASE ))
    fi
    echo "${_globals_cache[$1]}"
}


# Load globals[23] UART tags into name->var_id and var_id-presence maps.
load_uart_names() {
    [[ "$_uart_names_loaded" == 1 ]] && return 0

    local g23
    g23=$(globals_offset 23) || die "globals[23] not found"

    # globals[23] is a 26-bucket UART-name lookup table:
    # each bucket points to {char2, char3, var_id} entries for one first letter.
    while IFS=$'\t' read -r name vid; do
        [[ -n "$name" && -n "$vid" ]] || continue
        _var_by_name[$name]=$vid
        local vid_dec=$((vid))
        if [[ -z "${_var_id_present[$vid_dec]+x}" ]]; then
            _var_id_present[$vid_dec]=1
            _var_id_list+=("$vid_dec")
        fi
    done < <(
        perl -e '
            use strict;
            use warnings;

            my ($file, $g23, $flash_base) = @ARGV;
            $g23 += 0;
            $flash_base = oct($flash_base);

            open my $fh, "<:raw", $file or die "open: $!";
            local $/;
            my $data = <$fh>;
            my $len = length($data);

            my $u32 = sub {
                my ($off) = @_;
                return undef if $off < 0 || $off + 4 > $len;
                return unpack("V", substr($data, $off, 4));
            };

            for my $letter_idx (0..25) {
                my $off = $g23 + $letter_idx * 8;
                my $sub_ptr = $u32->($off);
                my $count = $u32->($off + 4);
                next if !defined($sub_ptr) || !defined($count) || $count > 200;

                my $sub_off = $sub_ptr - $flash_base;
                next if $sub_off < 0 || $sub_off + $count * 4 > $len;

                for my $j (0..$count - 1) {
                    my ($c2, $c3, $vid) = unpack("C C v", substr($data, $sub_off + $j * 4, 4));
                    printf "%s%c%c\t0x%04X\n", chr(ord("A") + $letter_idx), $c2, $c3, $vid;
                }
            }
        ' "$OUT" "$g23" "$FLASH_BASE"
    )

    _uart_names_loaded=1
}


# Return file offset of the nearest globals[] pointer after a file offset.
# args: file offset
next_global_offset_after() {
    local base_off=$(printf "%d" "$1")
    local base_ptr=$(( FLASH_BASE + base_off ))
    local best=

    for idx in {0..29}; do
        local ptr
        ptr=$(globals_ptr "$idx") || continue
        if is_flash_ptr "$ptr" && (( ptr > base_ptr )); then
            if [[ -z "$best" || ptr -lt best ]]; then
                best=$ptr
            fi
        fi
    done

    [[ -n "$best" ]] || return 1
    echo $(( best - FLASH_BASE ))
}


# Count records in a globals[] descriptor table using the next globals[] pointer.
# args: globals index, table file offset, record stride
var_table_count() {
    local tnum=$1
    local base=$(printf "%d" "$2")
    local stride=$(printf "%d" "$3")
    local end size rem count

    end=$(next_global_offset_after "$base") || die "cannot infer globals[$tnum] end"
    size=$(( end - base ))
    (( size > 0 )) || die "globals[$tnum] size $size is invalid"

    rem=$(( size % stride ))
    if (( rem != 0 )); then
        count=$(( size / stride ))
        # Older builds can align the next table after g[3] with a short zero pad.
        if (( tnum == 3 && rem < 4 && count > 0 )) && zero_padding $(( base + count * stride )) "$rem"; then
            echo "$count"
            return
        fi
        die "globals[$tnum] size 0x$(printf "%X" "$size") is not aligned to stride 0x$(printf "%X" "$stride")"
    fi

    echo $(( size / stride ))
}


# Test whether globals[23] contains the whole var_id range.
# args: first var_id, count
has_id_range() {
    local start=$(printf "%d" "$1")
    local count=$(printf "%d" "$2")
    local i

    for (( i = 0; i < count; i++ )); do
        [[ -n "${_var_id_present[$(( start + i ))]+x}" ]] || return 1
    done
    return 0
}


# Infer descriptor table var_id base from globals[23].
# args: globals index, record count, optional expected var_id base
infer_var_table_id_base() {
    local tnum=$1
    local count=$(printf "%d" "$2")
    local expected=${3-}

    if [[ -n "$expected" ]]; then
        expected=$(printf "%d" "$expected")
        if has_id_range "$expected" "$count"; then
            echo "$expected"
            return
        fi
        die "globals[$tnum] var_id range 0x$(printf "%04X" "$expected")..0x$(printf "%04X" $(( expected + count - 1 ))) missing from globals[23]"
    fi

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        if [[ -n "${_var_id_present[$(( candidate - 1 ))]+x}" ]]; then
            continue
        fi
        if has_id_range "$candidate" "$count"; then
            echo "$candidate"
            return
        fi
    done < <(printf "%s\n" "${_var_id_list[@]}" | sort -n)

    die "cannot infer globals[$tnum] var_id base from globals[23]"
}


# Derive descriptor offsets/counts/id bases from globals[] and globals[23].
load_var_tables() {
    [[ "$_var_tables_loaded" == 1 ]] && return 0
    load_uart_names

    local expected=
    for tnum in 3 4 6 8 9; do
        local ptr base stride count id_base
        ptr=$(globals_ptr "$tnum") || die "globals[$tnum] not found"
        is_flash_ptr "$ptr" || continue

        base=$(( ptr - FLASH_BASE ))
        stride=${_var_table_stride[$tnum]}
        count=$(var_table_count "$tnum" "$base" "$stride")
        id_base=$(infer_var_table_id_base "$tnum" "$count" "$expected")

        _var_table_base[$tnum]=$base
        _var_table_count[$tnum]=$count
        _var_table_id_base[$tnum]=$id_base
        expected=$(( id_base + count ))
    done

    _var_tables_loaded=1
}


# Descriptor lookup: returns file offset of a variable record for numeric var_id.
find_var_id() {
    local vid=$(printf "%d" "$1")
    load_var_tables

    for tnum in 3 4 6 8 9; do
        [[ -n "${_var_table_base[$tnum]+x}" ]] || continue

        local base=${_var_table_base[$tnum]}
        local count=${_var_table_count[$tnum]}
        local id_base=${_var_table_id_base[$tnum]}
        local stride=${_var_table_stride[$tnum]}

        if (( vid >= id_base && vid < id_base + count )); then
            echo $(( base + (vid - id_base) * stride ))
            return
        fi
    done

    die "find_var_id: var_id $1 not in derived descriptor tables"
}


# Return globals[] descriptor table number for a variable name/id.
find_var_table_number() {
    local vid=$(printf "%d" "$(resolve_var_id "$1")")
    load_var_tables

    for tnum in 3 4 6 8 9; do
        [[ -n "${_var_table_base[$tnum]+x}" ]] || continue

        local count=${_var_table_count[$tnum]}
        local id_base=${_var_table_id_base[$tnum]}
        if (( vid >= id_base && vid < id_base + count )); then
            echo "$tnum"
            return
        fi
    done

    die "find_var_table_number: var_id $1 not in derived descriptor tables"
}


# UART name lookup: returns numeric var_id
find_var_id_by_name() {
    load_uart_names
    local name=${1^^}
    local vid=${_var_by_name[$name]}
    [[ -n "$vid" ]] || die "unknown UART variable name: $1"
    echo "$vid"
}


# Accept UART names, decimal ids, or hex ids and return normalized numeric var_id.
resolve_var_id() {
    if [[ "$1" == 0x* || "$1" =~ ^[0-9]+$ ]]; then
        printf "0x%04X\n" "$(printf "%d" "$1")"
    else
        find_var_id_by_name "$1"
    fi
}


# Descriptor lookup by UART name.
find_var_name() {
    find_var_id "$(find_var_id_by_name "$1")"
}


# Smart descriptor lookup by UART name or numeric id.
find_var() {
    find_var_id "$(resolve_var_id "$1")"
}


# Return descriptor-table index, e.g. the value g[8].dep_head stores for g[4].
# args: globals table number, variable name/id
find_var_table_index() {
    local tnum=$1 var=$2 rec base stride count idx
    load_var_tables
    rec=$(find_var "$var") || die failed
    base=${_var_table_base[$tnum]}
    stride=${_var_table_stride[$tnum]}
    count=${_var_table_count[$tnum]}
    idx=$(( (rec - base) / stride ))
    if (( rec < base || idx < 0 || idx >= count || base + idx * stride != rec )); then
        die "find_var_table_index: $var is not in globals[$tnum]"
    fi
    echo "$idx"
}


# count locale slots the compiled string table actually has
infer_g2_language_count() {
    perl -e '
        use strict;
        use warnings;
        my ($file, $g2, $flash_base) = @ARGV;
        $g2 += 0;
        $flash_base = oct($flash_base);
        open my $fh, "<:raw", $file or die "open: $!";
        local $/;
        my $data = <$fh>;
        my $len = length($data);
        my $u32 = sub {
            my ($off) = @_;
            return undef if $off < 0 || $off + 4 > $len;
            return unpack("V", substr($data, $off, 4));
        };
        my @ptrs;
        for my $i (0..127) {
            my $ptr = $u32->($g2 + $i * 8 + 4);
            last if !$ptr || $ptr < $flash_base || $ptr >= $flash_base + $len;
            push @ptrs, $ptr;
        }
        die "globals[2] has too few locale arrays\n" if @ptrs < 2;
        my %deltas;
        for my $i (0..$#ptrs - 1) {
            my $d = $ptrs[$i + 1] - $ptrs[$i];
            $deltas{$d}++ if $d > 0 && $d % 2 == 0 && $d <= 128;
        }
        die "cannot infer language slot count from globals[2]\n" if !%deltas;
        my ($stride) = sort { $deltas{$b} <=> $deltas{$a} } keys %deltas;
        my $slots = int($stride / 2);
        my @sample = @ptrs[0 .. (@ptrs < 128 ? $#ptrs : 127)];
        while ($slots > 1) {
            my $all_zero = 1;
            for my $ptr (@sample) {
                my $off = $ptr - $flash_base + ($slots - 1) * 2;
                my $v = unpack("v", substr($data, $off, 2));
                if ($v != 0) {
                    $all_zero = 0;
                    last;
                }
            }
            last if !$all_zero;
            $slots--;
        }
        print "$slots\n";
    ' "$OUT" "$(globals_offset 2)" "$FLASH_BASE"
}


# Cache firmware-wide string metadata before any patch mutates descriptors.
load_firmware_string_metadata() {
    local rop rpo lan perm bit
    rop=$(find_var ROP) || die failed
    rpo=$(find_var RPO) || die failed
    lan=$(find_var LAN) || die failed

    STR_ID_EMPTY=$(read_u16 $(( rop + G8_NAME_STR )))
    STR_ID_OFF_ON_BASE=$(read_u16 $(( rpo + G8_BASE_STR )))
    FW_LANG_COUNT=$(infer_g2_language_count)

    perm=$(read_u32 $(( lan + G8_BITMASK )))
    FW_LANG_IDS=()
    for (( bit = 0; bit < 32; bit++ )); do
        if (( perm & (1 << bit) )); then
            FW_LANG_IDS+=("$bit")
        fi
    done
    (( ${#FW_LANG_IDS[@]} == FW_LANG_COUNT )) || \
        die "LAN language mask count ${#FW_LANG_IDS[@]} != globals[2] slots $FW_LANG_COUNT"
}


patch_crc() {
    local regions=(
        "$BLX_OFF $BLX_SIZE"
        "$CCX_OFF $CCX_SIZE"
        "$CDX_OFF $CDX_SIZE"
    )

    local off size payload_len crc

    echo "Updating checksums"

    for r in "${regions[@]}"; do
        read -r off size <<< "$r"
        off=$(printf "%d" "$off")
        size=$(printf "%d" "$size")
        payload_len=$(( size - 2 ))

        crc=$(crc16_region "$off" "$payload_len") || {
            echo "${FUNCNAME[0]}: CRC calculation failed"
            return 1
        }

        printf "  block @0x%05X (%d bytes) -> CRC %s\n" "$off" "$size" "$crc"

        printf '%b' "\x${crc:0:2}" "\x${crc:2:2}" | patch $(( off + payload_len ))
    done
}



# -----------------------------------------------------------------------------
# Generic custom-settings framework
# -----------------------------------------------------------------------------


# Reset generated custom-settings state before the feature pass.
custom_patch_settings_init() {
    CUSTOM_G8_POOL=()
    CUSTOM_G4_POOL=()
    CUSTOM_G8_RECLAIMED=()
    CUSTOM_G4_RECLAIMED=()
    CUSTOM_G8_CLAIMS=()
    CUSTOM_G4_CLAIMS=()
    CUSTOM_STRING_POOL=()
    CUSTOM_RECLAIMED_STRING_CANDIDATES=()
    CUSTOM_RECLAIMED_STRING_SEEN=()
    CUSTOM_MENU_ENTRIES=()
    CUSTOM_MENU_REGISTERED=()
}


# Remember a string ID that became reclaimable after descriptor scrubbing.
custom_note_reclaimed_string_id() {
    local sid
    sid=$(printf "%d" "$1")
    (( sid == STR_ID_EMPTY )) && return
    if [[ -z "${CUSTOM_RECLAIMED_STRING_SEEN[$sid]+x}" ]]; then
        CUSTOM_RECLAIMED_STRING_SEEN[$sid]=1
        CUSTOM_RECLAIMED_STRING_CANDIDATES+=("$sid")
    fi
}


# Build the reusable string pool from IDs captured while reclaiming variables.
# Reclaiming a descriptor only makes its old string IDs candidates: the same IDs
# may still be referenced by other descriptors or small string-index tables. Scan
# those known references after descriptor scrubbing and keep only unreferenced IDs.
custom_build_string_pool() {
    CUSTOM_STRING_POOL=()
    local candidates specs tnum g5 g5_end
    (( ${#CUSTOM_RECLAIMED_STRING_CANDIDATES[@]} > 0 )) || \
        die "custom_patch_settings: no reclaimed string IDs available"

    candidates=$(IFS=,; echo "${CUSTOM_RECLAIMED_STRING_CANDIDATES[*]}")
    specs=()
    for tnum in 3 4 6 8 9; do
        [[ -n "${_var_table_base[$tnum]+x}" ]] || continue
        specs+=("$tnum:${_var_table_base[$tnum]}:${_var_table_count[$tnum]}:${_var_table_stride[$tnum]}")
    done
    g5=$(globals_offset 5) || g5=-1
    g5_end=$(next_global_offset_after "$g5" 2>/dev/null || echo -1)

    mapfile -t CUSTOM_STRING_POOL < <(perl -e '
        use strict;
        use warnings;
        my ($file, $candidates_csv, $g4_name, $g4_units, $g8_name,
            $g8_base, $g5, $g5_end, @specs) = @ARGV;
        my $num = sub { $_[0] =~ /^0x/i ? hex($_[0]) : $_[0] + 0 };
        ($g4_name, $g4_units, $g8_name, $g8_base, $g5, $g5_end) =
            map { $num->($_) } ($g4_name, $g4_units, $g8_name, $g8_base, $g5, $g5_end);
        open my $fh, "<:raw", $file or die "open: $!";
        local $/;
        my $data = <$fh>;
        my $len = length($data);

        my @candidates = grep { length } split /,/, $candidates_csv;
        my %candidate = map { ($_ + 0) => 1 } @candidates;
        my %referenced;
        my $u16 = sub {
            my ($off) = @_;
            return undef if $off < 0 || $off + 2 > $len;
            return unpack("v", substr($data, $off, 2));
        };
        my $mark = sub {
            my ($sid) = @_;
            $referenced{$sid} = 1 if defined($sid) && exists $candidate{$sid};
        };

        for my $spec (@specs) {
            my ($tnum, $base, $count, $stride) = map { $num->($_) } split /:/, $spec;
            my @offs =
                $tnum == 3 ? (0x06) :
                $tnum == 4 ? ($g4_name, $g4_units) :
                $tnum == 6 ? (0x14) :
                ($g8_name, $g8_base);
            for my $i (0 .. $count - 1) {
                my $rec = $base + $i * $stride;
                $mark->($u16->($rec + $_)) for @offs;
            }
        }

        if ($g5 >= 0 && $g5_end > $g5) {
            for (my $off = $g5; $off + 1 < $g5_end; $off += 2) {
                $mark->($u16->($off));
            }
        }

        for my $sid (@candidates) {
            print "$sid\n" if !$referenced{$sid + 0};
        }
    ' "$OUT" "$candidates" "$G4_NAME_STR" "$G4_UNITS_STR" "$G8_NAME_STR" \
       "$G8_BASE_STR" "$g5" "$g5_end" "${specs[@]}")

    (( ${#CUSTOM_STRING_POOL[@]} > 0 )) || die "custom_patch_settings: no reclaimed string IDs available"
}


# Allocate one reclaimed string ID to a feature.
# args: output variable name, allocation owner label
custom_alloc_string() {
    local __out=$1 owner=$2
    (( ${#CUSTOM_STRING_POOL[@]} > 0 )) || die "custom_alloc_string: pool exhausted for $owner"
    local sid=${CUSTOM_STRING_POOL[0]}
    CUSTOM_STRING_POOL=("${CUSTOM_STRING_POOL[@]:1}")
    printf -v "$__out" "%s" "$sid"
}


# Rewrite a firmware string, allocating a reclaimed string ID when str_id is -1.
# The input array is indexed by ResMed language id. For each language compiled
# into the current image, write that language string or point missing locales at
# the English fallback.
# The locale array keeps pointing at raw string table entries; this helper only
# changes those raw pointers and updates the descriptor max length.
# Allocation prefers the existing raw string storage if the new text fits there.
# Otherwise it scans backward through CCX for a contiguous erased 0xFF range,
# writes the new NUL-terminated string there, and repoints the raw table entry.
# args: output variable name, string id|-1, associative localized-string array name
redefine_fw_string() {
    local __out=$1 str_id=$2 array_name=$3
    local -n strings=$array_name
    [[ -n "${strings[0]+x}" ]] || die "redefine_fw_string: $array_name missing English string at language id 0"

    if [[ "$str_id" == "-1" ]]; then
        custom_alloc_string str_id "$array_name"
    fi

    local tmp lang
    tmp=$(mktemp) || die "redefine_fw_string: mktemp failed"
    for lang in "${!strings[@]}"; do
        printf "%s\t%s\n" "$lang" "${strings[$lang]}" >> "$tmp"
    done

    perl -e '
        use strict;
        use warnings;
        my ($file, $flash_base, $ccx_off, $ccx_size, $g2, $lang_count,
            $lang_csv, $str_id, $map_file) = @ARGV;
        $flash_base = oct($flash_base);
        my $num = sub { $_[0] =~ /^0/ ? oct($_[0]) : int($_[0]) };
        $ccx_off = $num->($ccx_off);
        $ccx_size = $num->($ccx_size);
        $g2 = $num->($g2);
        $lang_count = $num->($lang_count);
        $str_id = $num->($str_id);

        open my $fh, "+<:raw", $file or die "open: $!";
        my $data;
        {
            local $/;
            $data = <$fh>;
        }
        my $len = length($data);

        my %text;
        open my $mf, "<:raw", $map_file or die "open map: $!";
        while (my $line = <$mf>) {
            chomp $line;
            my ($lang, $value) = split /\t/, $line, 2;
            $text{$lang + 0} = defined($value) ? $value : "";
        }
        die "missing English fallback\n" if !exists $text{0};
        my @lang_ids = split /,/, $lang_csv;
        die "language count mismatch\n" if @lang_ids != $lang_count;

        my $u16 = sub { unpack("v", substr($data, $_[0], 2)) };
        my $u32 = sub { unpack("V", substr($data, $_[0], 4)) };
        my $put16 = sub { substr($data, $_[0], 2) = pack("v", $_[1]) };
        my $put32 = sub { substr($data, $_[0], 4) = pack("V", $_[1]) };

        my $la0 = $u32->($g2 + 4);
        my $raw_indirect = $la0 - $flash_base - 8;
        die "invalid raw string table pointer\n" if $raw_indirect < 0 || $raw_indirect + 4 > $len;
        my $raw = $u32->($raw_indirect) - $flash_base;
        die "invalid raw string table\n" if $raw < 0 || $raw >= $len;

        my $alloc = sub {
            my ($bytes) = @_;
            my $need = length($bytes);
            my $limit = $ccx_off + $ccx_size - 2; # leave CCX CRC
            for (my $end = $limit; $end >= $ccx_off + $need; $end--) {
                my $start = $end - $need;
                if (substr($data, $start, $need) eq ("\xff" x $need)) {
                    substr($data, $start, $need) = $bytes;
                    return $start;
                }
            }
            die "no CCX string space for ${need} bytes\n";
        };

        my $cstrlen = sub {
            my ($off) = @_;
            return undef if $off < 0 || $off >= $len;
            my $end = index($data, "\0", $off);
            return undef if $end < 0;
            return $end - $off + 1;
        };

        my $rec = $g2 + $str_id * 8;
        my $locale_arr = $u32->($rec + 4) - $flash_base;
        die "invalid locale array for str_id $str_id\n" if $locale_arr < 0 || $locale_arr >= $len;

        my $english_ptr;
        my $max_len = 0;
        for my $slot (0..$lang_count - 1) {
            my $lang_id = $lang_ids[$slot] + 0;
            my $raw_idx = $u16->($locale_arr + $slot * 2);
            my $raw_ptr_off = $raw + $raw_idx * 4;
            die "raw string entry out of range\n" if $raw_ptr_off < 0 || $raw_ptr_off + 4 > $len;

            if (!exists $text{$lang_id} && defined $english_ptr) {
                $put32->($raw_ptr_off, $english_ptr);
                next;
            }

            my $s = exists $text{$lang_id} ? $text{$lang_id} : $text{0};
            my $bytes = $s . "\0";
            $max_len = length($bytes) - 1 if length($bytes) - 1 > $max_len;

            my $old = $u32->($raw_ptr_off) - $flash_base;
            my $old_cap = $cstrlen->($old);

            my $new_off;
            if (defined($old_cap) && length($bytes) <= $old_cap) {
                substr($data, $old, $old_cap) = $bytes . ("\0" x ($old_cap - length($bytes)));
                $new_off = $old;
            } else {
                $new_off = $alloc->($bytes);
            }
            my $new_ptr = $flash_base + $new_off;
            $put32->($raw_ptr_off, $new_ptr);
            $english_ptr = $new_ptr if $lang_id == 0;
        }

        $put16->($rec, $max_len);
        seek($fh, 0, 0) or die "seek: $!";
        print $fh $data;
        truncate($fh, length($data)) or die "truncate: $!";
    ' "$OUT" "$FLASH_BASE" "$CCX_OFF" "$CCX_SIZE" "$(globals_offset 2)" \
       "$FW_LANG_COUNT" "$(IFS=,; echo "${FW_LANG_IDS[*]}")" "$str_id" "$tmp" || {
        rm -f "$tmp"
        die "redefine_fw_string: failed for str_id 0x$(printf "%04X" "$str_id")"
    }
    rm -f "$tmp"
    printf -v "$__out" "%s" "$str_id"
}


# Reclaiming a stock variable scrubs its descriptor and adds it to a per-type
# pool of available variables. Feature patches can then claim entries from the
# matching pool and redefine their descriptors for custom use.

# Reclaim a g[8] enum/menu variable and capture its old string IDs.
custom_reclaim_g8_var() {
    local name=$1 rec vid name_str base_str
    vid=$(( $(resolve_var_id "$name") ))
    [[ -z "${CUSTOM_G8_RECLAIMED[$vid]+x}" ]] || \
        die "custom_reclaim_g8_var: duplicate reclaim of $name (var_id 0x$(printf "%04X" "$vid"))"
    rec=$(find_var "$name") || die failed
    name_str=$(read_u16 $(( rec + G8_NAME_STR )))
    base_str=$(read_u16 $(( rec + G8_BASE_STR )))
    write_u16 $(( rec + G8_NAME_STR )) "$STR_ID_EMPTY" || die failed
    write_u16 $(( rec + G8_BASE_STR )) "$STR_ID_EMPTY" || die failed
    custom_note_reclaimed_string_id "$name_str"
    custom_note_reclaimed_string_id "$base_str"
    CUSTOM_G8_RECLAIMED[$vid]="$name"
    CUSTOM_G8_POOL+=("$name")
}


# Reclaim a g[4] numeric variable and capture its old string IDs.
custom_reclaim_g4_var() {
    local name=$1 rec vid name_str units_str
    vid=$(( $(resolve_var_id "$name") ))
    [[ -z "${CUSTOM_G4_RECLAIMED[$vid]+x}" ]] || \
        die "custom_reclaim_g4_var: duplicate reclaim of $name (var_id 0x$(printf "%04X" "$vid"))"
    rec=$(find_var "$name") || die failed
    name_str=$(read_u16 $(( rec + G4_NAME_STR )))
    units_str=$(read_u16 $(( rec + G4_UNITS_STR )))
    write_u16 $(( rec + G4_NAME_STR )) "$STR_ID_EMPTY" || die failed
    write_u16 $(( rec + G4_UNITS_STR )) "$STR_ID_EMPTY" || die failed
    custom_note_reclaimed_string_id "$name_str"
    custom_note_reclaimed_string_id "$units_str"
    CUSTOM_G4_RECLAIMED[$vid]="$name"
    CUSTOM_G4_POOL+=("$name")
}


# Claim a specific reclaimed g[8] variable, keeping feature APIs stable.
# args: output variable name, requested variable name/id, optional owner label
custom_claim_g8_var() {
    local __out=$1 request=$2 owner=${3:-$2}
    local vid name
    vid=$(( $(resolve_var_id "$request") ))
    [[ -n "${CUSTOM_G8_RECLAIMED[$vid]+x}" ]] || \
        die "custom_claim_g8_var: $request (var_id 0x$(printf "%04X" "$vid")) is not reclaimed"
    [[ -z "${CUSTOM_G8_CLAIMS[$vid]+x}" ]] || \
        die "custom_claim_g8_var: $request (var_id 0x$(printf "%04X" "$vid")) already claimed by ${CUSTOM_G8_CLAIMS[$vid]}"
    name=${CUSTOM_G8_RECLAIMED[$vid]}
    CUSTOM_G8_CLAIMS[$vid]="$owner"
    printf -v "$__out" "%s" "$name"
}


