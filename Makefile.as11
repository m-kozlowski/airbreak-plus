AS11_FIRMWARE ?= as11.bin
AS11_PATCHED ?= $(BUILD)/as11-patched.bin

AS11_PATCHER_DEPS := \
	patch-airsense-s11 \
	python/patch-airsense-s11.py \
	python/as11_edf_superset.py \
	python/lib/as11_patch_versions.py \
	python/lib/compiled_payload.py

# Register APPL payloads by APPX version and FGBL payloads by BID.
AS11_PAYLOAD_LAYOUT_VERSIONS := 8_0_1 8_3_0 8_4_0 8_5_0 8_6_0
AS11_PAYLOADS_8_0_1 := as11_mop_callback_dispatcher as11_rpc_dispatcher as11_vid_spoof as11_header_clock as11_airbreak_info
AS11_PAYLOADS_8_3_0 := $(AS11_PAYLOADS_8_0_1) as11_asv_backup_rate as11_custom_settings
AS11_PAYLOADS_8_4_0 := $(AS11_PAYLOADS_8_3_0)
AS11_PAYLOADS_8_5_0 := $(AS11_PAYLOADS_8_3_0)
AS11_PAYLOADS_8_6_0 := $(AS11_PAYLOADS_8_5_0)

AS11_FGBL_PAYLOAD_VERSIONS := 1_1_0
AS11_FGBL_PAYLOADS_1_1_0 := as11_fgbl_service_gate as11_fgbl_service_extension
# FGBL payloads default to fgbl; list copied-to-SRAM payloads here.
AS11_FGBL_SRAM_PAYLOADS_1_1_0 := as11_fgbl_service_extension

# Resolve a payload name to its supported versions, binaries, and region.
as11_appl_payload_versions = $(strip $(foreach v,$(AS11_PAYLOAD_LAYOUT_VERSIONS),$(if $(filter $(1),$(AS11_PAYLOADS_$(v))),$(v))))
as11_fgbl_payload_versions = $(strip $(foreach v,$(AS11_FGBL_PAYLOAD_VERSIONS),$(if $(filter $(1),$(AS11_FGBL_PAYLOADS_$(v))),$(v))))
as11_payload_versions = $(strip $(call as11_appl_payload_versions,$(1)) $(call as11_fgbl_payload_versions,$(1)))
as11_payload_bins = $(foreach v,$(call as11_payload_versions,$(1)),$(BUILD)/$(1)_$(v).bin)
as11_payload_extra_objs = $(foreach o,$(AS11_PAYLOAD_EXTRA_OBJECTS_$(1)),$(BUILD)/$(o)_$(2).o)
as11_fgbl_payload_region = $(if $(filter $(1),$(AS11_FGBL_SRAM_PAYLOADS_$(2))),fgbl_sram,fgbl)
as11_layout_field = awk -v name="$(1)" -v field="$(2)" '$$$$1 == name { print $$$$field; found=1; exit } END { if (!found) exit 1 }' $(strip $(3))

AS11_APPL_PAYLOAD_NAMES := $(sort $(foreach v,$(AS11_PAYLOAD_LAYOUT_VERSIONS),$(AS11_PAYLOADS_$(v))))
AS11_FGBL_PAYLOAD_NAMES := $(sort $(foreach v,$(AS11_FGBL_PAYLOAD_VERSIONS),$(AS11_FGBL_PAYLOADS_$(v))))
AS11_PAYLOAD_NAMES := $(sort $(AS11_APPL_PAYLOAD_NAMES) $(AS11_FGBL_PAYLOAD_NAMES))
AS11_PAYLOAD_VERSIONS := $(sort $(AS11_PAYLOAD_LAYOUT_VERSIONS) $(AS11_FGBL_PAYLOAD_VERSIONS))
AS11_PAYLOAD_STAMPS := $(foreach p,$(AS11_PAYLOAD_NAMES),$(BUILD)/payload_$(p).stamp)
AS11_PAYLOAD_LAYOUT_TSVS := \
	$(foreach v,$(AS11_PAYLOAD_LAYOUT_VERSIONS),$(BUILD)/as11_payload_layout_$(v).tsv) \
	$(foreach v,$(AS11_FGBL_PAYLOAD_VERSIONS),$(BUILD)/as11_fgbl_payload_layout_$(v).tsv)

AS11_PAYLOAD_CFLAGS_as11_fgbl_service_extension := \
	-fno-builtin -fno-unwind-tables -fno-asynchronous-unwind-tables \
	-ffunction-sections
AS11_PAYLOAD_CFLAGS_as11_fgbl_lz4 := \
	-fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections \
	-DLZ4_FREESTANDING=1 -DLZ4_memcpy=service_lz4_memcpy \
	-DLZ4_memmove=service_lz4_memmove -DLZ4_memset=service_lz4_memset \
	-isystem $(shell $(CC) -print-file-name=include)
AS11_PAYLOAD_EXTRA_OBJECTS_as11_fgbl_service_extension := as11_fgbl_lz4
AS11_PAYLOAD_LDFLAGS_as11_fgbl_service_extension := --gc-sections

AS11_CFLAGS := \
	-g \
	-Os \
	-mcpu=cortex-m7 \
	-mthumb \
	-mfloat-abi=hard \
	-mfpu=fpv5-d16 \
	-W \
	-Wall \
	-Wno-unused-result \
	-Wno-unused-parameter \
	-Wno-unused-variable \
	-nostdlib \
	-nostdinc \
	-ffreestanding

AS11_NOR_READER_SRC := patches/stubs/as11-nor-sram-reader.c
AS11_NOR_READER_ELF := $(BUILD)/as11-nor-sram-reader.elf
AS11_NOR_READER_BIN := $(BUILD)/as11-nor-sram-reader.bin
AS11_NOR_READER_CFLAGS := \
	-g \
	-Os \
	-mcpu=cortex-m7 \
	-mthumb \
	-ffreestanding \
	-fno-builtin \
	-fno-toplevel-reorder \
	-fno-unwind-tables \
	-fno-asynchronous-unwind-tables \
	-nostdlib \
	-nostartfiles \
	-W \
	-Wall \
	-Wno-unused-result \
	-Wno-unused-parameter \
	-Wno-unused-variable

# Probe sizes feed the code-cave allocator for each region and version.
# $(1): default region, $(2): version, $(3): output stem, $(4): payload list
define AS11_PAYLOAD_LAYOUT_template
$$(BUILD)/$(3)_payload_sizes_$(2).tsv: \
		$$(foreach p,$(4),$$(BUILD)/$$(p)_$(2).probe.bin) \
		Makefile Makefile.as11 | $$(BUILD)
	@: > $$@.tmp
	@for bin in $$(filter %.probe.bin,$$^); do \
		base=$$$${bin##*/}; \
		name=$$$${base%_$(2).probe.bin}; \
		region=$(1); \
		case ' $$(AS11_FGBL_SRAM_PAYLOADS_$(2)) ' in \
			*" $$$$name "*) region=fgbl_sram ;; \
		esac; \
		printf '%s\t%s\t%s\n' "$$$$name" "$$$$(stat -c %s "$$$$bin")" "$$$$region" >> $$@.tmp; \
	done
	@mv $$@.tmp $$@

$$(BUILD)/$(3)_payload_layout_$(2).tsv: \
		$$(BUILD)/$(3)_payload_sizes_$(2).tsv $$(SRC)/as11_code_caves.tsv \
		$$(SRC)/generate_payload_layout.awk | $$(BUILD)
	@awk -v version=$(2) \
		-f $$(SRC)/generate_payload_layout.awk \
		$$(SRC)/as11_code_caves.tsv $$(BUILD)/$(3)_payload_sizes_$(2).tsv \
		> $$@.tmp
	@mv $$@.tmp $$@
endef

$(foreach v,$(AS11_PAYLOAD_LAYOUT_VERSIONS),\
	$(eval $(call AS11_PAYLOAD_LAYOUT_template,appl,$(v),as11,$(AS11_PAYLOADS_$(v)))))
$(foreach v,$(AS11_FGBL_PAYLOAD_VERSIONS),\
	$(eval $(call AS11_PAYLOAD_LAYOUT_template,fgbl,$(v),as11_fgbl,$(AS11_FGBL_PAYLOADS_$(v)))))

$(BUILD)/as11_stubs_%.o: $(SRC)/as11/stubs_%.S Makefile Makefile.as11 | $(BUILD)
	$(AS) $(AS11_CFLAGS) -DAPPX_VER_$* -DFGBL_VER_$* -c -o $@ $<

$(BUILD)/as11_fgbl_stubs_%.o: $(SRC)/as11/fgbl_stubs_%.S Makefile Makefile.as11 | $(BUILD)
	$(AS) $(AS11_CFLAGS) -DAPPX_VER_$* -DFGBL_VER_$* -c -o $@ $<

# APPL and FGBL payloads share one versioned object rule.
define AS11_VERSIONED_OBJECTS_template
$$(BUILD)/as11_%_$(1).o: $$(SRC)/as11/%.c $$(SRC)/as11/stubs.h \
		$$(SRC)/as11/rpc_object.h $$(SRC)/as11/vars.h \
		$$(wildcard $$(SRC)/as11/vars_$(1).h) \
		Makefile Makefile.as11 | $$(BUILD)
	$$(CC) $$(AS11_CFLAGS) $$(AS11_PAYLOAD_CFLAGS_as11_$$*) \
		-DAPPX_VER_$(1) -DFGBL_VER_$(1) -c -o $$@ $$<

$$(BUILD)/as11_%_$(1).o: $$(SRC)/as11/%.S $$(SRC)/as11/stubs.h \
		$$(SRC)/as11/vars.h $$(wildcard $$(SRC)/as11/vars_$(1).h) \
		Makefile Makefile.as11 | $$(BUILD)
	$$(AS) $$(AS11_CFLAGS) -DAPPX_VER_$(1) -DFGBL_VER_$(1) -c -o $$@ $$<
endef

$(foreach v,$(AS11_PAYLOAD_VERSIONS),$(eval $(call AS11_VERSIONED_OBJECTS_template,$(v))))

$(BUILD)/as11_fgbl_lz4_%.o: \
		$(SRC)/as11/lz4/lz4.c $(SRC)/as11/lz4/lz4.h

# Probe links derive runtime addresses from storage mappings; final links use
# the allocator-selected runtime address and must retain the probed size.
# $(1): payload, $(2): version, $(3): region, $(4): stubs, $(5): layout
define AS11_PAYLOAD_template
$$(BUILD)/$(1)_$(2).probe.elf: $$(BUILD)/$(1)_$(2).o $(strip $(4)) \
		$$(call as11_payload_extra_objs,$(1),$(2)) \
		$$(SRC)/as11_code_caves.tsv Makefile Makefile.as11 | $$(BUILD)
	@set -e; mapping=$$$$(awk -v version="$(2)" -v region="$(strip $(3))" \
		'$$$$1 == version && $$$$2 == region { print $$$$3, $$$$5, $$$$6; found=1; exit } END { if (!found) exit 1 }' \
		$$(SRC)/as11_code_caves.tsv); \
	set -- $$$$mapping; \
	addr=$$$$(printf '0x%08X' $$$$(( $$$$3 + $$$$1 - $$$$2 ))); \
	$$(LD) --nostdlib --no-dynamic-linker $$(AS11_PAYLOAD_LDFLAGS_$(1)) \
		--Ttext $$$$addr --entry start --sort-section=name \
		-o $$@ $$(filter %.o,$$^)

$$(BUILD)/$(1)_$(2).probe.bin: $$(BUILD)/$(1)_$(2).probe.elf
	$$(OBJCOPY) -O binary $$< $$@

$$(BUILD)/$(1)_$(2).elf: $$(BUILD)/$(1)_$(2).o $(strip $(4)) \
		$$(call as11_payload_extra_objs,$(1),$(2)) $(strip $(5)) | $$(BUILD)
	@set -e; addr=$$$$($(call as11_layout_field,$(1),2,$(strip $(5)))); \
	$$(LD) --nostdlib --no-dynamic-linker $$(AS11_PAYLOAD_LDFLAGS_$(1)) \
		--Ttext $$$$addr --entry start --sort-section=name \
		-o $$@ $$(filter %.o,$$^)

$$(BUILD)/$(1)_$(2).bin: $$(BUILD)/$(1)_$(2).elf
	$$(OBJCOPY) -Obinary $$< $$@
	@set -e; actual=$$$$(stat -c %s $$@); \
		expected=$$$$($(call as11_layout_field,$(1),3,$(strip $(5)))); \
		[ "$$$$actual" -eq "$$$$expected" ] || { \
			echo "$$@: final size $$$$actual differs from layout size $$$$expected" >&2; \
			exit 1; \
		}
endef

$(foreach p,$(AS11_APPL_PAYLOAD_NAMES),\
	$(foreach v,$(call as11_appl_payload_versions,$(p)),\
		$(eval $(call AS11_PAYLOAD_template,$(p),$(v),appl,\
			$(BUILD)/as11_stubs_$(v).o,$(BUILD)/as11_payload_layout_$(v).tsv))))
$(foreach p,$(AS11_FGBL_PAYLOAD_NAMES),\
	$(foreach v,$(call as11_fgbl_payload_versions,$(p)),\
		$(eval $(call AS11_PAYLOAD_template,$(p),$(v),\
			$(call as11_fgbl_payload_region,$(p),$(v)),\
			$(BUILD)/as11_fgbl_stubs_$(v).o,\
			$(BUILD)/as11_fgbl_payload_layout_$(v).tsv))))

# Top-level builds consume one stamp per registered payload.
define AS11_PAYLOAD_STAMP_template
$(BUILD)/payload_$(1).stamp: $(call as11_payload_bins,$(1)) Makefile Makefile.as11 | $(BUILD)
	@printf '  %-8s %-30s [%s]\n' PAYLOAD $(1) '$(call as11_payload_versions,$(1))'
	@touch $$@
endef

$(foreach p,$(AS11_PAYLOAD_NAMES),$(eval $(call AS11_PAYLOAD_STAMP_template,$(p))))

.PHONY: as11 as11-binaries as11-patched as11-nor-sram-reader

as11:
	@: > '$(MAKE_LOG)'
	@if $(MAKE) --no-print-directory -q $(AS11_PAYLOAD_STAMPS) $(AS11_PAYLOAD_LAYOUT_TSVS); then \
		:; \
	else \
		status=$$?; \
		[ "$$status" -eq 1 ] || exit "$$status"; \
		printf 'Building payloads\n'; \
		$(MAKE) --no-print-directory as11-binaries; \
	fi
	$(MAKE) --no-print-directory $(AS11_PATCHED)
	@printf '\nFirmware image:\n  %s\n' '$(AS11_PATCHED)' | tee -a '$(MAKE_LOG)'

as11-binaries: $(AS11_PAYLOAD_STAMPS) $(AS11_PAYLOAD_LAYOUT_TSVS)

$(AS11_NOR_READER_ELF): $(AS11_NOR_READER_SRC) Makefile Makefile.as11 | $(BUILD)
	$(CC) $(AS11_NOR_READER_CFLAGS) \
		-Wl,-Ttext=0x24000000 \
		-Wl,-e,_start \
		-Wl,--build-id=none \
		-o $@ $<

$(AS11_NOR_READER_BIN): $(AS11_NOR_READER_ELF)
	$(OBJCOPY) -O binary $< $@

as11-nor-sram-reader: $(AS11_NOR_READER_BIN)
	@echo "AS11 NOR SRAM reader built:"
	@echo "  $(AS11_NOR_READER_BIN)"

as11-patched:
	@: > '$(MAKE_LOG)'
	-$(MAKE) --no-print-directory as11-binaries
	$(MAKE) --no-print-directory $(AS11_PATCHED)
	@printf '\nFirmware image:\n  %s\n' '$(AS11_PATCHED)' | tee -a '$(MAKE_LOG)'

$(AS11_PATCHED): $(AS11_FIRMWARE) $(AS11_PATCHER_DEPS) \
		$(AS11_PAYLOAD_STAMPS) $(AS11_PAYLOAD_LAYOUT_TSVS) | $(BUILD)
	$(announce_image)
	./patch-airsense-s11 $< $@ $(PATCHER_OUTPUT_ARGS)
